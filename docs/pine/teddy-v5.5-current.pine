//@version=5
// Dibuat oleh Gemini berdasarkan strategi pengguna
// Versi 5.5: Perbaikan final 'line.new' untuk Sinar Horizontal
indicator("teddy v5.5 (Sinar Final)", overlay=true)

// =================================================================================
// BAGIAN 1: PENGATURAN INPUT DARI PENGGUNA
// =================================================================================

// (Bagian ini tidak ada perubahan)
var GRP_GENERAL = "Pengaturan Umum"
minPercentInput = input.float(15.0, "Persentase Pergerakan Harga Minimal (%)", group = GRP_GENERAL) / 100
labelTextColor = input.color(color.white, "Warna Teks Label", group = GRP_GENERAL)
labelTextSizeInput = input.string("small", "Ukuran Teks Label", options=["tiny", "small", "normal", "large"], group = GRP_GENERAL)

f_stringToSize(sizeString) =>
    switch sizeString
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.small
labelTextSize = f_stringToSize(labelTextSizeInput)

var GRP_RED = "Warna Garis Merah"
colorRedD1 = input.color(color.new(#ff8787, 0), "1D", group = GRP_RED, inline = "R1")
colorRedW1 = input.color(color.new(#ff5d5d, 0), "1W", group = GRP_RED, inline = "R1")
colorRedM1 = input.color(color.new(#ff3333, 0), "1M", group = GRP_RED, inline = "R2")
colorRedM3 = input.color(color.new(#f01111, 0), "3M", group = GRP_RED, inline = "R2")
colorRedM6 = input.color(color.new(#d40000, 0), "6M", group = GRP_RED, inline = "R3")
colorRedM12 = input.color(color.new(#aa0000, 0), "12M", group = GRP_RED, inline = "R3")

var GRP_GREEN = "Warna Garis Hijau"
colorGreenD1 = input.color(color.new(#7fff87, 0), "1D", group = GRP_GREEN, inline = "G1")
colorGreenW1 = input.color(color.new(#57ff5d, 0), "1W", group = GRP_GREEN, inline = "G1")
colorGreenM1 = input.color(color.new(#33ff33, 0), "1M", group = GRP_GREEN, inline = "G2")
colorGreenM3 = input.color(color.new(#11f011, 0), "3M", group = GRP_GREEN, inline = "G2")
colorGreenM6 = input.color(color.new(#00d400, 0), "6M", group = GRP_GREEN, inline = "G3")
colorGreenM12 = input.color(color.new(#00aa00, 0), "12M", group = GRP_GREEN, inline = "G3")

var GRP_TF = "Pengaturan Tampilan Timeframe"
showD1 = input.bool(true, "1D", group = GRP_TF, inline = "T1")
widthD1 = input.int(1, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T1")
showW1 = input.bool(true, "1W", group = GRP_TF, inline = "T2")
widthW1 = input.int(1, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T2")
showM1 = input.bool(true, "1M", group = GRP_TF, inline = "T3")
widthM1 = input.int(2, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T3")
showM3 = input.bool(true, "3M", group = GRP_TF, inline = "T4")
widthM3 = input.int(3, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T4")
showM6 = input.bool(true, "6M", group = GRP_TF, inline = "T5")
widthM6 = input.int(4, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T5")
showM12 = input.bool(true, "12M", group = GRP_TF, inline = "T6")
widthM12 = input.int(2, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T6")


// =================================================================================
// BAGIAN 2: FUNGSI UNTUK MENDETEKSI SINYAL DAN MENGGAMBAR GARIS/LABEL
// =================================================================================

f_processTimeframe(timeframe, labelText, show, colorRed, colorGreen, width) =>
    isRedCandle = close < open
    isGreenCandle = close > open
   
    signalGreenOnRed = isRedCandle and (math.abs(high - open) / open >= minPercentInput)
    signalRedOnRed   = isRedCandle and (math.abs(close - low) / close >= minPercentInput)

    signalGreenOnGreen = isGreenCandle and (math.abs(high - close) / open >= minPercentInput)
    signalRedOnGreen   = isGreenCandle and (math.abs(open - low) / open >= minPercentInput)

    [tf_high, tf_low, tf_sGOR, tf_sROR, tf_sGOG, tf_sROG] = request.security(syminfo.tickerid, timeframe,
     [high, low, signalGreenOnRed, signalRedOnRed, signalGreenOnGreen, signalRedOnGreen], lookahead=barmerge.lookahead_on)

    // --- PERBAIKAN DI 4 BLOK DI BAWAH INI ---
    // Menambahkan `x2` dan `y2` agar fungsi `line.new` valid

    if show and tf_sGOR and not tf_sGOR[1]
        line.new(x1=bar_index, y1=tf_high, x2=bar_index + 1, y2=tf_high, color=colorGreen, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_high, text=labelText + " " + str.tostring(tf_high, format.mintick), color=colorGreen, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
       
    if show and tf_sROR and not tf_sROR[1]
        line.new(x1=bar_index, y1=tf_low, x2=bar_index + 1, y2=tf_low, color=colorRed, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_low, text=labelText + " " + str.tostring(tf_low, format.mintick), color=colorRed, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
       
    if show and tf_sGOG and not tf_sGOG[1]
        line.new(x1=bar_index, y1=tf_high, x2=bar_index + 1, y2=tf_high, color=colorGreen, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_high, text=labelText + " " + str.tostring(tf_high, format.mintick), color=colorGreen, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
       
    if show and tf_sROG and not tf_sROG[1]
        line.new(x1=bar_index, y1=tf_low, x2=bar_index + 1, y2=tf_low, color=colorRed, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_low, text=labelText + " " + str.tostring(tf_low, format.mintick), color=colorRed, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)

// =================================================================================
// BAGIAN 3: MENJALANKAN FUNGSI UNTUK SETIAP TIMEFRAME
// =================================================================================

f_processTimeframe("D", "1D", showD1, colorRedD1, colorGreenD1, widthD1)
f_processTimeframe("W", "1W", showW1, colorRedW1, colorGreenW1, widthW1)
f_processTimeframe("M", "1M", showM1, colorRedM1, colorGreenM1, widthM1)
f_processTimeframe("3M", "3M", showM3, colorRedM3, colorGreenM3, widthM3)
f_processTimeframe("6M", "6M", showM6, colorRedM6, colorGreenM6, widthM6)
f_processTimeframe("12M", "12M", showM12, colorRedM12, colorGreenM12, widthM12)
