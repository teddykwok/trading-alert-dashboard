//@version=5
// Dibuat oleh Gemini berdasarkan strategi pengguna
// Versi 5.5: Perbaikan final 'line.new' untuk Sinar Horizontal
// Versi 5.5-retest (model breakout/acceptance -> retest):
//   - Level "sinar" (whale footprint) DISIMPAN di array saat terbentuk.
//     Pembentukan level murni visual + registrasi — TIDAK mengirim alert.
//   - Script ini TIDAK PERNAH mengirim sinyal WATCH.
//   - Level harus ARMED dulu lewat candle chart CONFIRMED (bar close):
//       GREEN armed saat close > upperBand (harga diterima DI ATAS level)
//       RED   armed saat close < lowerBand (harga diterima DI BAWAH level)
//     Disarm saat close confirmed menembus sisi sebaliknya; level yang patah
//     harus diterima ulang sebelum retest berikutnya bisa valid.
//   - Retest valid (eventType=LEVEL_TOUCHED):
//       GREEN armed, disentuh TURUN dari atas  -> LONG  (retest support)
//       RED   armed, disentuh NAIK  dari bawah -> SHORT (retest resistance)
//       sentuhan sisi salah / level belum armed -> TIDAK ada alert sama sekali
//   - Cooldown per level hanya terpakai saat alert LONG/SHORT benar terkirim.
//   - Semua logika visual pembentukan level (line.new / label.new / input
//     warna & timeframe) TIDAK diubah.
//   - "timeframe" di JSON = timeframe CHART (format backend, mis. "1h") agar
//     screenshot Binance memakai interval yang valid; detail level ada di "note".
// Versi 5.5-dynamic (aturan produk Teddy; sama dengan engine Native
// TEDDY_DYNAMIC_SOURCE_LEVEL_V1):
//   - 7% HANYA gerbang kualifikasi (GOR/ROR/GOG/ROG tidak diubah), BUKAN harga level.
//   - Per timeframe sumber + candle sumber + warna hanya ada SATU kandidat yang
//     sedang terbentuk: GREEN (GOR atau GOG) mengikuti HIGH berjalan candle sumber,
//     RED (ROR atau ROG) mengikuti LOW berjalan. Perubahan warna body (GOR->GOG)
//     tetap kandidat yang sama.
//   - Kandidat aktif hanya selama kualifikasinya benar; kalau hilang ia NONAKTIF
//     (tersembunyi, tidak bisa armed/retest/alert); kalau kembali benar di candle
//     sumber yang sama, kandidat yang SAMA aktif lagi (anchor pembuatan = kualifikasi
//     pertama, tidak di-reset). Tidak ada level duplikat dari kedipan kualifikasi.
//   - Saat candle sumber selesai: kandidat yang MASIH lolos menjadi tepat SATU level
//     permanen di ekstrem final; yang tidak lolos DIBUANG (tidak ada level sama sekali).
//   - Hanya level permanen yang masuk array retest (MAX_LEVELS hanya untuk level
//     permanen), yang bisa ARMED / disarm / retest.
//   - Timer = N bar chart PENUH setelah close anchor: alert boleh paling cepat di
//     bar ke-(N+1) (15m: creation 5 = 75 menit, arming 4 = 60 menit, cooldown 10 =
//     sepuluh bar penuh). Sebelumnya `>= N` mengizinkan alert Immediate satu bar lebih awal.
//   - Mode Immediate: loop retest dijalankan SEBELUM ARMED/DISARM pada tick
//     konfirmasi, sehingga cooldown alert yang sudah terkirim ikut tercommit walau
//     candle yang sama lalu ditutup menembus level (disarm). alert.freq_once_per_bar
//     mencegah alert ganda di bar yang sama.
indicator("teddy v5.5 (Sinar Final)",overlay=true,max_lines_count=500,max_labels_count=500)

// =================================================================================
// BAGIAN 1: PENGATURAN INPUT DARI PENGGUNA
// =================================================================================

// (Bagian ini tidak ada perubahan)
var GRP_GENERAL = "Pengaturan Umum"
minPercentInput = input.float(7.0, "Persentase Pergerakan Harga Minimal (%)", group = GRP_GENERAL) / 100
labelTextColor = input.color(color.white, "Warna Teks Label", group = GRP_GENERAL)
labelTextSizeInput = input.string("small", "Ukuran Teks Label", options=["tiny", "small", "normal", "large"], group = GRP_GENERAL)

f_stringToSize(sizeString) =>
    switch sizeString
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.small
labelTextSize = f_stringToSize(labelTextSizeInput)

var GRP_RED = "Warna Garis Merah"
colorRedD1 = input.color(color.new(#ff8787, 0), "1D", group = GRP_RED, inline = "R1")
colorRedW1 = input.color(color.new(#ff5d5d, 0), "1W", group = GRP_RED, inline = "R1")
colorRedM1 = input.color(color.new(#ff3333, 0), "1M", group = GRP_RED, inline = "R2")
colorRedM3 = input.color(color.new(#f01111, 0), "3M", group = GRP_RED, inline = "R2")
colorRedM6 = input.color(color.new(#d40000, 0), "6M", group = GRP_RED, inline = "R3")
colorRedM12 = input.color(color.new(#aa0000, 0), "12M", group = GRP_RED, inline = "R3")

var GRP_GREEN = "Warna Garis Hijau"
colorGreenD1 = input.color(color.new(#7fff87, 0), "1D", group = GRP_GREEN, inline = "G1")
colorGreenW1 = input.color(color.new(#57ff5d, 0), "1W", group = GRP_GREEN, inline = "G1")
colorGreenM1 = input.color(color.new(#33ff33, 0), "1M", group = GRP_GREEN, inline = "G2")
colorGreenM3 = input.color(color.new(#11f011, 0), "3M", group = GRP_GREEN, inline = "G2")
colorGreenM6 = input.color(color.new(#00d400, 0), "6M", group = GRP_GREEN, inline = "G3")
colorGreenM12 = input.color(color.new(#00aa00, 0), "12M", group = GRP_GREEN, inline = "G3")

var GRP_TF = "Pengaturan Tampilan Timeframe"
showD1 = input.bool(true, "1D", group = GRP_TF, inline = "T1")
widthD1 = input.int(1, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T1")
showW1 = input.bool(true, "1W", group = GRP_TF, inline = "T2")
widthW1 = input.int(1, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T2")
showM1 = input.bool(true, "1M", group = GRP_TF, inline = "T3")
widthM1 = input.int(2, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T3")
showM3 = input.bool(true, "3M", group = GRP_TF, inline = "T4")
widthM3 = input.int(3, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T4")
showM6 = input.bool(true, "6M", group = GRP_TF, inline = "T5")
widthM6 = input.int(4, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T5")
showM12 = input.bool(true, "12M", group = GRP_TF, inline = "T6")
widthM12 = input.int(2, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T6")

// --- Pengaturan Webhook ---
var GRP_WEBHOOK = "Webhook"
webhookSecret = input.string("", "Webhook Secret", group = GRP_WEBHOOK)
assetTypeInput = input.string("crypto", "Asset Type", options=["crypto", "stock"], group = GRP_WEBHOOK)
exchangeInput = input.string("BINANCE", "Exchange", group = GRP_WEBHOOK)
enableWebhookAlerts = input.bool(true, "Enable Webhook Alerts", group = GRP_WEBHOOK)
enableLevelTouchedAlerts = input.bool(true, "Alert When Price Touches Existing Level", group = GRP_WEBHOOK)
touchTolerancePct = input.float(1.0, "Touch Tolerance (%)", group = GRP_WEBHOOK) / 100
touchCooldownBars = input.int(10, "Touch Alert Cooldown Bars", minval=1, group = GRP_WEBHOOK)
minBarsAfterCreation = input.int(5, "Min Bars After Level Creation Before Touch Alert", minval=1, group = GRP_WEBHOOK)
// Jarak minimal antara bar ARMED dan retest — retest tidak boleh terjadi di
// bar yang sama dengan arming (aturan terpisah dari minBarsAfterCreation).
minBarsAfterArming = input.int(4, "Min Bars After Arming Before Retest", minval=1, group = GRP_WEBHOOK)
// "Immediate" = LONG/SHORT dikirim saat tick pertama sentuhan valid pada level
// yang SUDAH armed (sekali per bar per level); "Bar Close" = tunggu candle
// chart ditutup. ARMED/DISARM selalu memakai close confirmed, apa pun mode ini.
touchAlertTiming = input.string("Immediate", "Touch Alert Timing", options=["Immediate", "Bar Close"], group = GRP_WEBHOOK)

// --- Marker visual untuk retest LONG/SHORT (BAGIAN 4). Murni tampilan;
//     muncul HANYA saat alert actionable yang sama lolos semua syarat. ---
var GRP_MARKERS = "Visual Touch Markers"
showTouchSignalMarkers = input.bool(true, "Show LONG / SHORT Markers", group = GRP_MARKERS)
touchMarkerTextSizeInput = input.string("small", "Marker Text Size", options = ["tiny", "small", "normal"], group = GRP_MARKERS)
touchMarkerTextSize = f_stringToSize(touchMarkerTextSizeInput)
longMarkerColor = input.color(color.green, "LONG Marker Color", group = GRP_MARKERS)
shortMarkerColor = input.color(color.red, "SHORT Marker Color", group = GRP_MARKERS)

// =================================================================================
// BAGIAN 1B: HELPER JSON WEBHOOK
// =================================================================================

// Mengubah timeframe CHART aktif (timeframe.period, mis. "60", "240", "D")
// menjadi token yang dimengerti backend/Binance: "1m","5m","15m","1h","4h","1d".
f_chartTimeframeForBackend() =>
    tfMult = timeframe.multiplier
    timeframe.isminutes ?
         (tfMult % 60 == 0 ? str.tostring(tfMult / 60) + "h" : str.tostring(tfMult) + "m") :
     timeframe.isdaily ? str.tostring(tfMult) + "d" :
     timeframe.isweekly ? str.tostring(tfMult) + "w" :
     timeframe.ismonthly ? str.tostring(tfMult) + "M" :
     timeframe.period

chartTfForBackend = f_chartTimeframeForBackend()

f_formatPrice(value) =>
    str.tostring(value, "#.##########")

// Payload JSON untuk POST /api/webhooks/tradingview. Field ekstra sengaja
// TIDAK ditambahkan (validasi Zod backend membuang field tak dikenal) —
// semua detail level/sentuhan dimasukkan ke "note".
//
// DUA STEMPEL WAKTU, ARTINYA BERBEDA:
//
//   "triggeredAt" = timenow = saat alert BENAR-BENAR terpicu (wall clock).
//                   Inilah waktu sentuhan level yang sesungguhnya, dan inilah
//                   yang dipakai backend untuk menilai kesegaran sinyal.
//   "barTime"     = time    = waktu BUKA candle sumber.
//
// Sebelumnya "triggeredAt" mengirim `time`, sehingga sentuhan pukul 11:07 pada
// candle 15m yang dibuka 11:00 terbaca sudah berumur 7 menit dan tertolak
// ALERT_STALE walau webhook dikirim seketika. Untuk mode "Immediate" alert
// memakai alert.freq_once_per_bar yang memang berjalan INTRABAR secara
// realtime, jadi `timenow` adalah waktu peristiwa yang otoritatif; untuk mode
// konfirmasi (once_per_bar_close) `timenow` adalah saat bar ditutup — juga
// waktu peristiwa yang benar. `time` tetap dikirim terpisah supaya konteks
// candle tidak hilang.
// "indicatorValue" = input "Persentase Pergerakan Harga Minimal (%)" dalam
// POIN PERSEN (input 7.0 -> 7, 12.5 -> 12.5), BUKAN pecahan 0.07 — dashboard
// menampilkannya sebagai "MOVE ≥7%". Format "#.####" menjaga angka JSON tetap
// valid: tanpa notasi ilmiah, tanpa ekor desimal float, desimal berguna utuh.
f_buildWebhookJson(signal, levelPrice, note) =>
    '{'
     + '"secret":"' + webhookSecret + '",'
     + '"symbol":"' + syminfo.tickerid + '",'
     + '"assetType":"' + assetTypeInput + '",'
     + '"timeframe":"' + chartTfForBackend + '",'
     + '"price":' + f_formatPrice(levelPrice) + ','
     + '"signal":"' + signal + '",'
     + '"indicatorName":"teddy v5.5",'
     + '"indicatorValue":' + str.tostring(minPercentInput * 100, "#.####") + ','
     + '"triggeredAt":"' + str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",'
     + '"barTime":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",'
     + '"exchange":"' + exchangeInput + '",'
     + '"note":"' + note + '"'
     + '}'

// =================================================================================
// BAGIAN 1C: PENYIMPANAN LEVEL (BARU)
// =================================================================================

// Setiap level PERMANEN (candle sumber sudah selesai dan masih lolos 7%) disimpan
// di array paralel ini, supaya bisa dideteksi saat harga kembali menyentuhnya.
// Kandidat yang masih terbentuk TIDAK pernah masuk sini.
var MAX_LEVELS = 500
var lvlPrice = array.new_float()
var lvlColor = array.new_string()      // "GREEN" / "RED"
var lvlTf = array.new_string()         // "1D","1W","1M","3M","6M","12M"
var lvlCreatedBar = array.new_int()
var lvlLastTouchBar = array.new_int()  // -1 = belum pernah kirim alert retest
// Status acceptance per level (model breakout -> retest):
// GREEN armed = harga sudah DITERIMA di atas level (close confirmed > upperBand)
// RED   armed = harga sudah DITERIMA di bawah level (close confirmed < lowerBand)
// Hanya level armed yang boleh menghasilkan alert retest.
var lvlArmed = array.new_bool()
var lvlArmedBar = array.new_int()      // -1 = belum/tidak armed

// createdBar = anchor pembuatan: bar kualifikasi PERTAMA kandidat di candle sumbernya.
f_registerLevel(levelPrice, colorName, tfLabel, createdBar) =>
    array.push(lvlPrice, levelPrice)
    array.push(lvlColor, colorName)
    array.push(lvlTf, tfLabel)
    array.push(lvlCreatedBar, createdBar)
    array.push(lvlLastTouchBar, -1)
    array.push(lvlArmed, false)
    array.push(lvlArmedBar, -1)
    // Batasi jumlah level agar loop retest tetap ringan; buang yang tertua.
    // Semua array paralel HARUS di-shift bersama agar index tetap sejajar.
    if array.size(lvlPrice) > MAX_LEVELS
        array.shift(lvlPrice)
        array.shift(lvlColor)
        array.shift(lvlTf)
        array.shift(lvlCreatedBar)
        array.shift(lvlLastTouchBar)
        array.shift(lvlArmed)
        array.shift(lvlArmedBar)

// =================================================================================
// BAGIAN 2: FUNGSI UNTUK MENDETEKSI SINYAL DAN MENGGAMBAR GARIS/LABEL
// =================================================================================

f_processTimeframe(timeframe, labelText, show, colorRed, colorGreen, width) =>
    isRedCandle = close < open
    isGreenCandle = close > open

    signalGreenOnRed = isRedCandle and (math.abs(high - open) / open >= minPercentInput)
    signalRedOnRed   = isRedCandle and (math.abs(close - low) / close >= minPercentInput)

    signalGreenOnGreen = isGreenCandle and (math.abs(high - close) / open >= minPercentInput)
    signalRedOnGreen   = isGreenCandle and (math.abs(open - low) / open >= minPercentInput)

    // tf_time = waktu BUKA candle sumber: berubah tepat saat candle sumber baru dimulai.
    [tf_time, tf_high, tf_low, tf_sGOR, tf_sROR, tf_sGOG, tf_sROG] = request.security(syminfo.tickerid, timeframe,
     [time, high, low, signalGreenOnRed, signalRedOnRed, signalGreenOnGreen, signalRedOnGreen], lookahead=barmerge.lookahead_on)

    // --- Kandidat yang sedang terbentuk: SATU GREEN dan SATU RED per candle sumber.
    //     `var` di dalam fungsi disimpan per pemanggilan, jadi tiap timeframe punya
    //     state sendiri. Pembentukan/update/finalisasi TIDAK mengirim alert apa pun;
    //     alert entry LONG/SHORT hanya dari loop retest di BAGIAN 4. ---
    var bool  gExists = false
    var bool  gActive = false
    var float gPrice = na
    var int   gFirstBar = na
    var int   gFirstTime = na
    var line  gLine = na
    var label gLabel = na
    var bool  rExists = false
    var bool  rActive = false
    var float rPrice = na
    var int   rFirstBar = na
    var int   rFirstTime = na
    var line  rLine = na
    var label rLabel = na

    // 1. Candle sumber sebelumnya SELESAI: finalisasi atau buang kandidatnya.
    //    Nilai g*/r* di sini masih dari close bar terakhir candle sumber itu.
    newSourceCandle = not na(tf_time[1]) and tf_time != tf_time[1]
    if newSourceCandle
        line.delete(gLine)
        label.delete(gLabel)
        line.delete(rLine)
        label.delete(rLabel)
        if gExists and gActive
            line.new(x1=gFirstTime, y1=gPrice, x2=time, y2=gPrice, xloc=xloc.bar_time, color=colorGreen, style=line.style_solid, width=width, extend=extend.right)
            label.new(gFirstTime, gPrice, text=labelText + " " + str.tostring(gPrice, format.mintick), xloc=xloc.bar_time, color=colorGreen, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
            f_registerLevel(gPrice, "GREEN", labelText, gFirstBar)
        if rExists and rActive
            line.new(x1=rFirstTime, y1=rPrice, x2=time, y2=rPrice, xloc=xloc.bar_time, color=colorRed, style=line.style_solid, width=width, extend=extend.right)
            label.new(rFirstTime, rPrice, text=labelText + " " + str.tostring(rPrice, format.mintick), xloc=xloc.bar_time, color=colorRed, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
            f_registerLevel(rPrice, "RED", labelText, rFirstBar)
        gExists := false
        gActive := false
        gPrice := na
        gLine := na
        gLabel := na
        rExists := false
        rActive := false
        rPrice := na
        rLine := na
        rLabel := na

    // 2. Candle sumber yang sedang berjalan: buat / ikuti ekstrem / aktif-nonaktif.
    greenQualifies = show and (tf_sGOR or tf_sGOG)
    redQualifies = show and (tf_sROR or tf_sROG)
    if greenQualifies and not gExists
        gExists := true
        gFirstBar := bar_index
        gFirstTime := time
    if gExists
        gActive := greenQualifies
        gPrice := tf_high
        if na(gLine)
            gLine := line.new(x1=gFirstTime, y1=gPrice, x2=time, y2=gPrice, xloc=xloc.bar_time, color=colorGreen, style=line.style_dashed, width=width, extend=extend.right)
            gLabel := label.new(time, gPrice, text=labelText + " forming", xloc=xloc.bar_time, color=colorGreen, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
        line.set_y1(gLine, gPrice)
        line.set_y2(gLine, gPrice)
        line.set_x2(gLine, time)
        line.set_color(gLine, gActive ? colorGreen : color.new(colorGreen, 100))
        label.set_xy(gLabel, time, gPrice)
        label.set_text(gLabel, labelText + " forming " + str.tostring(gPrice, format.mintick))
        label.set_color(gLabel, gActive ? colorGreen : color.new(colorGreen, 100))
        label.set_textcolor(gLabel, gActive ? labelTextColor : color.new(labelTextColor, 100))
    if redQualifies and not rExists
        rExists := true
        rFirstBar := bar_index
        rFirstTime := time
    if rExists
        rActive := redQualifies
        rPrice := tf_low
        if na(rLine)
            rLine := line.new(x1=rFirstTime, y1=rPrice, x2=time, y2=rPrice, xloc=xloc.bar_time, color=colorRed, style=line.style_dashed, width=width, extend=extend.right)
            rLabel := label.new(time, rPrice, text=labelText + " forming", xloc=xloc.bar_time, color=colorRed, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
        line.set_y1(rLine, rPrice)
        line.set_y2(rLine, rPrice)
        line.set_x2(rLine, time)
        line.set_color(rLine, rActive ? colorRed : color.new(colorRed, 100))
        label.set_xy(rLabel, time, rPrice)
        label.set_text(rLabel, labelText + " forming " + str.tostring(rPrice, format.mintick))
        label.set_color(rLabel, rActive ? colorRed : color.new(colorRed, 100))
        label.set_textcolor(rLabel, rActive ? labelTextColor : color.new(labelTextColor, 100))

// =================================================================================
// BAGIAN 3: MENJALANKAN FUNGSI UNTUK SETIAP TIMEFRAME
// =================================================================================

f_processTimeframe("D", "1D", showD1, colorRedD1, colorGreenD1, widthD1)
f_processTimeframe("W", "1W", showW1, colorRedW1, colorGreenW1, widthW1)
f_processTimeframe("M", "1M", showM1, colorRedM1, colorGreenM1, widthM1)
f_processTimeframe("3M", "3M", showM3, colorRedM3, colorGreenM3, widthM3)
f_processTimeframe("6M", "6M", showM6, colorRedM6, colorGreenM6, widthM6)
f_processTimeframe("12M", "12M", showM12, colorRedM12, colorGreenM12, widthM12)

// =================================================================================
// BAGIAN 4A: UPDATE STATUS ARMED PER LEVEL (HANYA CLOSE CONFIRMED)
// =================================================================================

// Acceptance dinilai dari candle chart yang DITUTUP, apa pun touchAlertTiming:
// - GREEN: close > upperBand  -> armed (support tervalidasi dari atas);
//          close < lowerBand  -> disarm (support patah, harus diterima ulang).
// - RED  : close < lowerBand  -> armed (resistance tervalidasi dari bawah);
//          close > upperBand  -> disarm (resistance patah).
// armedBar hanya di-set saat TRANSISI unarmed -> armed (tidak di-reset setiap
// bar selama harga bertahan), supaya minBarsAfterArming mengukur umur arming.
// Status ini selalu di-update, terlepas dari toggle webhook, agar state tetap
// benar saat alert diaktifkan kembali.
f_armDisarm() =>
    if barstate.isconfirmed and array.size(lvlPrice) > 0
        for i = 0 to array.size(lvlPrice) - 1
            levelPrice = array.get(lvlPrice, i)
            upperBand = levelPrice * (1 + touchTolerancePct)
            lowerBand = levelPrice * (1 - touchTolerancePct)
            isGreen = array.get(lvlColor, i) == "GREEN"
            armed = array.get(lvlArmed, i)

            armNow = isGreen ? close > upperBand : close < lowerBand
            breakNow = isGreen ? close < lowerBand : close > upperBand

            if not armed and armNow
                array.set(lvlArmed, i, true)
                array.set(lvlArmedBar, i, bar_index)
            else if armed and breakNow
                array.set(lvlArmed, i, false)
                array.set(lvlArmedBar, i, -1)

// =================================================================================
// BAGIAN 4B: DETEKSI RETEST LEVEL ARMED -> ALERT ENTRY LONG/SHORT
// =================================================================================

// Retest valid harus memenuhi SEMUA syarat:
// - level armed, dan sudah lewat minBarsAfterArming bar PENUH sejak bar arming
//   (bar_index - armedBar > minBarsAfterArming);
// - sudah lewat minBarsAfterCreation bar PENUH sejak anchor pembuatan;
// - cooldown: sudah lewat touchCooldownBars bar PENUH sejak alert terakhir;
// - geometri approach benar: close bar SEBELUMNYA masih di luar pita pada sisi
//   yang benar, dan bar INI masuk ke pita toleransi. GREEN disentuh dari bawah
//   atau RED dari atas TIDAK menghasilkan apa pun — tanpa alert, tanpa marker,
//   dan TANPA memakai cooldown (lvlLastTouchBar hanya di-set saat alert
//   LONG/SHORT benar-benar terkirim).
// Duplicate suppression backend tetap menjadi lapisan kedua.
f_retestLoop(prevClose) =>
    if enableWebhookAlerts and enableLevelTouchedAlerts and webhookSecret != "" and array.size(lvlPrice) > 0
        for i = 0 to array.size(lvlPrice) - 1
            levelPrice = array.get(lvlPrice, i)
            upperBand = levelPrice * (1 + touchTolerancePct)
            lowerBand = levelPrice * (1 - touchTolerancePct)
            levelColor = array.get(lvlColor, i)

            // Timer = N bar PENUH: paling cepat di bar ke-(N+1) setelah anchor.
            armedBar = array.get(lvlArmedBar, i)
            armedReady = array.get(lvlArmed, i) and armedBar >= 0 and bar_index - armedBar > minBarsAfterArming
            oldEnough = bar_index - array.get(lvlCreatedBar, i) > minBarsAfterCreation
            lastTouch = array.get(lvlLastTouchBar, i)
            cooledDown = lastTouch < 0 or bar_index - lastTouch > touchCooldownBars
            inBand = low <= upperBand and high >= lowerBand

            // LONG: support GREEN diretest TURUN dari atas — close sebelumnya di
            // atas pita, bar ini turun menyentuh pita. Naik dari bawah menembus
            // level tidak akan lolos karena close[1] tidak di atas pita.
            longRetest = levelColor == "GREEN" and prevClose > upperBand and inBand
            // SHORT: resistance RED diretest NAIK dari bawah (cermin LONG).
            shortRetest = levelColor == "RED" and prevClose < lowerBand and inBand

            if (longRetest or shortRetest) and armedReady and oldEnough and cooledDown
                touchSignal = longRetest ? "LONG" : "SHORT"
                touchDirection = longRetest ? "FROM_ABOVE" : "FROM_BELOW"
                touchNote = "eventType=LEVEL_TOUCHED | levelColor=" + levelColor + " | sourceTf=" + array.get(lvlTf, i) + " | touchDirection=" + touchDirection + " | levelPrice=" + f_formatPrice(levelPrice) + " | chartTf=" + chartTfForBackend + " | alertTiming=" + touchAlertTiming

                // "Immediate" boleh intrabar KARENA arming sudah dari close
                // confirmed sebelumnya: breakout terkonfirmasi + retest instan.
                // Entry = levelPrice (level PERSIS), bukan harga sentuhan pita.
                if touchAlertTiming == "Immediate"
                    alert(f_buildWebhookJson(touchSignal, levelPrice, touchNote), alert.freq_once_per_bar)
                else
                    alert(f_buildWebhookJson(touchSignal, levelPrice, touchNote), alert.freq_once_per_bar_close)
                array.set(lvlLastTouchBar, i, bar_index)

                // Marker visual: hanya untuk event LONG/SHORT yang sama persis
                // dengan alert di atas. Teks ringkas: sinyal + TF sumber level.
                markerTf = array.get(lvlTf, i)
                if showTouchSignalMarkers and touchSignal == "LONG"
                    label.new(bar_index, low, text="LONG " + markerTf, color=longMarkerColor, textcolor=labelTextColor, style=label.style_label_up, size=touchMarkerTextSize)
                if showTouchSignalMarkers and touchSignal == "SHORT"
                    label.new(bar_index, high, text="SHORT " + markerTf, color=shortMarkerColor, textcolor=labelTextColor, style=label.style_label_down, size=touchMarkerTextSize)

// =================================================================================
// BAGIAN 4C: URUTAN EKSEKUSI
// =================================================================================

// Immediate: retest DULU, baru ARMED/DISARM. Pada tick konfirmasi, loop retest
// melihat status armed yang sama dengan tick intrabar (sebelum 4A), jadi alert
// yang sudah terkirim intrabar ikut meng-commit cooldown-nya walau close bar ini
// lalu men-disarm level. freq_once_per_bar mencegah kiriman kedua di bar yang sama.
// Bar Close: tetap 4A dulu (close yang menembus level tidak mengirim alert).
// close[1] dibaca di scope global pada setiap bar, lalu diteruskan ke loop.
prevClose = close[1]
if touchAlertTiming == "Immediate"
    f_retestLoop(prevClose)
    f_armDisarm()
else
    f_armDisarm()
    f_retestLoop(prevClose)
