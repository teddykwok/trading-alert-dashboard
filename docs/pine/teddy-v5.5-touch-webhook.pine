//@version=5
// Dibuat oleh Gemini berdasarkan strategi pengguna
// Versi 5.5: Perbaikan final 'line.new' untuk Sinar Horizontal
// Versi 5.5-touch-webhook:
//   - Level "sinar" (whale footprint) sekarang DISIMPAN di array saat terbentuk.
//   - Pembentukan level TIDAK lagi mengirim sinyal LONG/SHORT. Opsional kirim
//     WATCH (eventType=LEVEL_CREATED) jika enableLevelCreatedAlerts aktif.
//   - Alert entry dikirim saat harga KEMBALI menyentuh level lama
//     (eventType=LEVEL_TOUCHED), dengan arah berdasarkan arah sentuhan:
//       GREEN disentuh dari ATAS  -> LONG  (retest sebagai support)
//       RED   disentuh dari BAWAH -> SHORT (retest sebagai resistance)
//       sentuhan lain             -> WATCH
//   - Semua logika visual (line.new / label.new / input warna & timeframe)
//     TIDAK diubah.
//   - "timeframe" di JSON = timeframe CHART (format backend, mis. "1h") agar
//     screenshot Binance memakai interval yang valid; detail level ada di "note".
indicator("teddy v5.5 (Sinar Final)", overlay=true)

// =================================================================================
// BAGIAN 1: PENGATURAN INPUT DARI PENGGUNA
// =================================================================================

// (Bagian ini tidak ada perubahan)
var GRP_GENERAL = "Pengaturan Umum"
minPercentInput = input.float(15.0, "Persentase Pergerakan Harga Minimal (%)", group = GRP_GENERAL) / 100
labelTextColor = input.color(color.white, "Warna Teks Label", group = GRP_GENERAL)
labelTextSizeInput = input.string("small", "Ukuran Teks Label", options=["tiny", "small", "normal", "large"], group = GRP_GENERAL)

f_stringToSize(sizeString) =>
    switch sizeString
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.small
labelTextSize = f_stringToSize(labelTextSizeInput)

var GRP_RED = "Warna Garis Merah"
colorRedD1 = input.color(color.new(#ff8787, 0), "1D", group = GRP_RED, inline = "R1")
colorRedW1 = input.color(color.new(#ff5d5d, 0), "1W", group = GRP_RED, inline = "R1")
colorRedM1 = input.color(color.new(#ff3333, 0), "1M", group = GRP_RED, inline = "R2")
colorRedM3 = input.color(color.new(#f01111, 0), "3M", group = GRP_RED, inline = "R2")
colorRedM6 = input.color(color.new(#d40000, 0), "6M", group = GRP_RED, inline = "R3")
colorRedM12 = input.color(color.new(#aa0000, 0), "12M", group = GRP_RED, inline = "R3")

var GRP_GREEN = "Warna Garis Hijau"
colorGreenD1 = input.color(color.new(#7fff87, 0), "1D", group = GRP_GREEN, inline = "G1")
colorGreenW1 = input.color(color.new(#57ff5d, 0), "1W", group = GRP_GREEN, inline = "G1")
colorGreenM1 = input.color(color.new(#33ff33, 0), "1M", group = GRP_GREEN, inline = "G2")
colorGreenM3 = input.color(color.new(#11f011, 0), "3M", group = GRP_GREEN, inline = "G2")
colorGreenM6 = input.color(color.new(#00d400, 0), "6M", group = GRP_GREEN, inline = "G3")
colorGreenM12 = input.color(color.new(#00aa00, 0), "12M", group = GRP_GREEN, inline = "G3")

var GRP_TF = "Pengaturan Tampilan Timeframe"
showD1 = input.bool(true, "1D", group = GRP_TF, inline = "T1")
widthD1 = input.int(1, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T1")
showW1 = input.bool(true, "1W", group = GRP_TF, inline = "T2")
widthW1 = input.int(1, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T2")
showM1 = input.bool(true, "1M", group = GRP_TF, inline = "T3")
widthM1 = input.int(2, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T3")
showM3 = input.bool(true, "3M", group = GRP_TF, inline = "T4")
widthM3 = input.int(3, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T4")
showM6 = input.bool(true, "6M", group = GRP_TF, inline = "T5")
widthM6 = input.int(4, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T5")
showM12 = input.bool(true, "12M", group = GRP_TF, inline = "T6")
widthM12 = input.int(2, "Tebal", minval=1, maxval=5, group = GRP_TF, inline = "T6")

// --- Pengaturan Webhook ---
var GRP_WEBHOOK = "Webhook"
webhookSecret = input.string("", "Webhook Secret", group = GRP_WEBHOOK)
assetTypeInput = input.string("crypto", "Asset Type", options=["crypto", "stock"], group = GRP_WEBHOOK)
exchangeInput = input.string("BINANCE", "Exchange", group = GRP_WEBHOOK)
enableWebhookAlerts = input.bool(true, "Enable Webhook Alerts", group = GRP_WEBHOOK)
enableLevelCreatedAlerts = input.bool(false, "Alert When Level Is Created", group = GRP_WEBHOOK)
enableLevelTouchedAlerts = input.bool(true, "Alert When Price Touches Existing Level", group = GRP_WEBHOOK)
touchTolerancePct = input.float(0.2, "Touch Tolerance (%)", group = GRP_WEBHOOK) / 100
touchCooldownBars = input.int(10, "Touch Alert Cooldown Bars", minval=1, group = GRP_WEBHOOK)
minBarsAfterCreation = input.int(5, "Min Bars After Level Creation Before Touch Alert", minval=1, group = GRP_WEBHOOK)

// =================================================================================
// BAGIAN 1B: HELPER JSON WEBHOOK
// =================================================================================

// Mengubah timeframe CHART aktif (timeframe.period, mis. "60", "240", "D")
// menjadi token yang dimengerti backend/Binance: "1m","5m","15m","1h","4h","1d".
f_chartTimeframeForBackend() =>
    tfMult = timeframe.multiplier
    timeframe.isminutes ?
         (tfMult % 60 == 0 ? str.tostring(tfMult / 60) + "h" : str.tostring(tfMult) + "m") :
     timeframe.isdaily ? str.tostring(tfMult) + "d" :
     timeframe.isweekly ? str.tostring(tfMult) + "w" :
     timeframe.ismonthly ? str.tostring(tfMult) + "M" :
     timeframe.period

chartTfForBackend = f_chartTimeframeForBackend()

f_formatPrice(value) =>
    str.tostring(value, "#.##########")

// Payload JSON untuk POST /api/webhooks/tradingview. Field ekstra sengaja
// TIDAK ditambahkan (validasi Zod backend membuang field tak dikenal) —
// semua detail level/sentuhan dimasukkan ke "note".
f_buildWebhookJson(signal, levelPrice, note) =>
    '{'
     + '"secret":"' + webhookSecret + '",'
     + '"symbol":"' + syminfo.tickerid + '",'
     + '"assetType":"' + assetTypeInput + '",'
     + '"timeframe":"' + chartTfForBackend + '",'
     + '"price":' + f_formatPrice(levelPrice) + ','
     + '"signal":"' + signal + '",'
     + '"indicatorName":"teddy v5.5",'
     + '"indicatorValue":0,'
     + '"triggeredAt":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",'
     + '"exchange":"' + exchangeInput + '",'
     + '"note":"' + note + '"'
     + '}'

// =================================================================================
// BAGIAN 1C: PENYIMPANAN LEVEL (BARU)
// =================================================================================

// Setiap level "sinar" yang tergambar juga disimpan di array paralel ini,
// supaya bisa dideteksi saat harga kembali menyentuhnya di masa depan.
var MAX_LEVELS = 500
var lvlPrice = array.new_float()
var lvlColor = array.new_string()      // "GREEN" / "RED"
var lvlTf = array.new_string()         // "1D","1W","1M","3M","6M","12M"
var lvlCreatedBar = array.new_int()
var lvlLastTouchBar = array.new_int()  // -1 = belum pernah kirim alert sentuhan

f_registerLevel(levelPrice, colorName, tfLabel) =>
    array.push(lvlPrice, levelPrice)
    array.push(lvlColor, colorName)
    array.push(lvlTf, tfLabel)
    array.push(lvlCreatedBar, bar_index)
    array.push(lvlLastTouchBar, -1)
    // Batasi jumlah level agar loop sentuhan tetap ringan; buang yang tertua.
    if array.size(lvlPrice) > MAX_LEVELS
        array.shift(lvlPrice)
        array.shift(lvlColor)
        array.shift(lvlTf)
        array.shift(lvlCreatedBar)
        array.shift(lvlLastTouchBar)

// Alert opsional saat level BARU terbentuk (bukan sinyal entry -> WATCH).
f_maybeAlertLevelCreated(levelPrice, colorName, tfLabel) =>
    if enableWebhookAlerts and enableLevelCreatedAlerts and webhookSecret != ""
        note = "eventType=LEVEL_CREATED | levelColor=" + colorName + " | sourceTf=" + tfLabel + " | levelPrice=" + f_formatPrice(levelPrice) + " | chartTf=" + chartTfForBackend
        alert(f_buildWebhookJson("WATCH", levelPrice, note), alert.freq_once_per_bar_close)

// =================================================================================
// BAGIAN 2: FUNGSI UNTUK MENDETEKSI SINYAL DAN MENGGAMBAR GARIS/LABEL
// =================================================================================

f_processTimeframe(timeframe, labelText, show, colorRed, colorGreen, width) =>
    isRedCandle = close < open
    isGreenCandle = close > open

    signalGreenOnRed = isRedCandle and (math.abs(high - open) / open >= minPercentInput)
    signalRedOnRed   = isRedCandle and (math.abs(close - low) / close >= minPercentInput)

    signalGreenOnGreen = isGreenCandle and (math.abs(high - close) / open >= minPercentInput)
    signalRedOnGreen   = isGreenCandle and (math.abs(open - low) / open >= minPercentInput)

    [tf_high, tf_low, tf_sGOR, tf_sROR, tf_sGOG, tf_sROG] = request.security(syminfo.tickerid, timeframe,
     [high, low, signalGreenOnRed, signalRedOnRed, signalGreenOnGreen, signalRedOnGreen], lookahead=barmerge.lookahead_on)

    // --- PERBAIKAN DI 4 BLOK DI BAWAH INI ---
    // Menambahkan `x2` dan `y2` agar fungsi `line.new` valid
    // --- TOUCH-WEBHOOK: level disimpan (f_registerLevel); pembentukan level
    //     TIDAK mengirim sinyal entry, hanya WATCH opsional. Entry dikirim
    //     oleh loop sentuhan di BAGIAN 4. ---

    if show and tf_sGOR and not tf_sGOR[1]
        line.new(x1=bar_index, y1=tf_high, x2=bar_index + 1, y2=tf_high, color=colorGreen, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_high, text=labelText + " " + str.tostring(tf_high, format.mintick), color=colorGreen, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
        f_registerLevel(tf_high, "GREEN", labelText)
        f_maybeAlertLevelCreated(tf_high, "GREEN", labelText)

    if show and tf_sROR and not tf_sROR[1]
        line.new(x1=bar_index, y1=tf_low, x2=bar_index + 1, y2=tf_low, color=colorRed, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_low, text=labelText + " " + str.tostring(tf_low, format.mintick), color=colorRed, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
        f_registerLevel(tf_low, "RED", labelText)
        f_maybeAlertLevelCreated(tf_low, "RED", labelText)

    if show and tf_sGOG and not tf_sGOG[1]
        line.new(x1=bar_index, y1=tf_high, x2=bar_index + 1, y2=tf_high, color=colorGreen, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_high, text=labelText + " " + str.tostring(tf_high, format.mintick), color=colorGreen, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
        f_registerLevel(tf_high, "GREEN", labelText)
        f_maybeAlertLevelCreated(tf_high, "GREEN", labelText)

    if show and tf_sROG and not tf_sROG[1]
        line.new(x1=bar_index, y1=tf_low, x2=bar_index + 1, y2=tf_low, color=colorRed, style=line.style_solid, width=width, extend=extend.right)
        label.new(bar_index, tf_low, text=labelText + " " + str.tostring(tf_low, format.mintick), color=colorRed, textcolor=labelTextColor, style=label.style_label_left, size=labelTextSize)
        f_registerLevel(tf_low, "RED", labelText)
        f_maybeAlertLevelCreated(tf_low, "RED", labelText)

// =================================================================================
// BAGIAN 3: MENJALANKAN FUNGSI UNTUK SETIAP TIMEFRAME
// =================================================================================

f_processTimeframe("D", "1D", showD1, colorRedD1, colorGreenD1, widthD1)
f_processTimeframe("W", "1W", showW1, colorRedW1, colorGreenW1, widthW1)
f_processTimeframe("M", "1M", showM1, colorRedM1, colorGreenM1, widthM1)
f_processTimeframe("3M", "3M", showM3, colorRedM3, colorGreenM3, widthM3)
f_processTimeframe("6M", "6M", showM6, colorRedM6, colorGreenM6, widthM6)
f_processTimeframe("12M", "12M", showM12, colorRedM12, colorGreenM12, widthM12)

// =================================================================================
// BAGIAN 4: DETEKSI SENTUHAN LEVEL LAMA (BARU) -> ALERT ENTRY
// =================================================================================

// Setiap bar chart, periksa semua level tersimpan:
// - "Disentuh" jika range bar ini overlap dengan pita toleransi level.
// - Arah sentuhan dari posisi close bar sebelumnya terhadap level.
// - Anti-spam: tunggu minBarsAfterCreation setelah level dibuat (otomatis
//   mencegah alert di bar pembuatan), lalu cooldown touchCooldownBars antar
//   alert untuk level yang sama. Duplicate suppression backend tetap menjadi
//   lapisan kedua.
if enableWebhookAlerts and enableLevelTouchedAlerts and webhookSecret != "" and array.size(lvlPrice) > 0
    for i = 0 to array.size(lvlPrice) - 1
        levelPrice = array.get(lvlPrice, i)
        upperBand = levelPrice * (1 + touchTolerancePct)
        lowerBand = levelPrice * (1 - touchTolerancePct)

        isTouched = high >= lowerBand and low <= upperBand
        oldEnough = bar_index - array.get(lvlCreatedBar, i) >= minBarsAfterCreation
        lastTouch = array.get(lvlLastTouchBar, i)
        cooledDown = lastTouch < 0 or bar_index - lastTouch >= touchCooldownBars

        if isTouched and oldEnough and cooledDown
            touchDirection = close[1] > levelPrice and low <= upperBand ? "FROM_ABOVE" : close[1] < levelPrice and high >= lowerBand ? "FROM_BELOW" : "UNKNOWN"
            levelColor = array.get(lvlColor, i)

            // GREEN diretest dari atas = support -> LONG.
            // RED diretest dari bawah = resistance -> SHORT. Lainnya WATCH.
            touchSignal = levelColor == "GREEN" and touchDirection == "FROM_ABOVE" ? "LONG" : levelColor == "RED" and touchDirection == "FROM_BELOW" ? "SHORT" : "WATCH"

            touchNote = "eventType=LEVEL_TOUCHED | levelColor=" + levelColor + " | sourceTf=" + array.get(lvlTf, i) + " | touchDirection=" + touchDirection + " | levelPrice=" + f_formatPrice(levelPrice) + " | chartTf=" + chartTfForBackend

            alert(f_buildWebhookJson(touchSignal, levelPrice, touchNote), alert.freq_once_per_bar_close)
            array.set(lvlLastTouchBar, i, bar_index)
