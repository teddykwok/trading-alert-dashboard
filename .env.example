# PostgreSQL connection used by Prisma (backend + worker)
# Port 55432 matches docker-compose.yml's host mapping (chosen to avoid clashing
# with a locally installed Postgres on the default 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/trading_alert_dashboard?schema=public

# Redis connection used by BullMQ (queue + worker)
REDIS_URL=redis://localhost:6379

# Backend HTTP server
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# Shared secret TradingView must send in the webhook payload
WEBHOOK_SECRET=change-me

# Where generated chart screenshots are written, relative to apps/backend
SCREENSHOT_STORAGE_DIR=src/storage/screenshots

# AI Vision provider selection: "mock" for now, swap for a real provider key later
AI_VISION_PROVIDER=mock

# Optional Telegram notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
