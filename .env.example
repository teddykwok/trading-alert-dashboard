# PostgreSQL connection used by Prisma (backend + worker)
# Port 55432 matches docker-compose.yml's host mapping (chosen to avoid clashing
# with a locally installed Postgres on the default 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/trading_alert_dashboard?schema=public

# Redis connection used by BullMQ (queue + worker)
REDIS_URL=redis://localhost:6379

# Backend HTTP server
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# Base URL for dashboard links shared outside the app (Telegram messages).
# Set to your public/tunnel frontend URL when testing from a phone.
PUBLIC_DASHBOARD_URL=http://localhost:5173

# Shared secret TradingView must send in the webhook payload
WEBHOOK_SECRET=change-me

# Where generated chart screenshots are written, relative to apps/backend
SCREENSHOT_STORAGE_DIR=src/storage/screenshots

# AI Vision provider: "mock" (default, no API calls) or "openai" (real vision).
AI_VISION_PROVIDER=mock

# OpenAI vision credentials/config. OPENAI_API_KEY is REQUIRED when
# AI_VISION_PROVIDER=openai (startup fails clearly otherwise).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Max time to wait for the AI vision response before aborting.
AI_VISION_TIMEOUT_MS=30000

# If the real AI provider fails: "true" logs a warning and returns a mock
# result; "false" (default) fails the worker job (alert -> FAILED).
AI_VISION_FALLBACK_TO_MOCK=false

# Reject screenshots larger than this many bytes before sending to the AI
# provider (cost/safety guard). Default 5 MB.
AI_VISION_MAX_IMAGE_BYTES=5000000

# Alerts matching symbol+assetType+timeframe+signal+indicatorName within this
# many seconds of an existing alert are suppressed as duplicates instead of
# creating a new alert / screenshot / AI analysis job.
DUPLICATE_SUPPRESSION_WINDOW_SECONDS=60

# Rate limiting (two separate policies).
# Private dashboard reads + /screenshots/* statics. One dashboard load issues
# roughly one screenshot request per alert card (hundreds), so this budget is
# generous on purpose — it is a runaway-loop guard, not a security control
# (the dashboard is private via Tailscale).
DASHBOARD_RATE_LIMIT_MAX=2000
DASHBOARD_RATE_LIMIT_WINDOW=1 minute

# Public TradingView webhook (internet-facing via Cloudflare tunnel). This IS a
# security control and is budgeted independently of dashboard traffic.
WEBHOOK_RATE_LIMIT_MAX=60
WEBHOOK_RATE_LIMIT_WINDOW=1 minute

# Binance public REST API base URL (no API key needed for klines/candles)
BINANCE_REST_BASE_URL=https://api.binance.com

# Binance USD-M Futures REST base URL, used for TradingView ".P" perpetual
# symbols (e.g. BINANCE:GRASSUSDT.P -> /fapi/v1/klines). No API key needed.
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com

# Market data provider for CRYPTO alerts on the BINANCE exchange. Currently
# only "binance" (real klines) is implemented; anything else falls back to
# mock candles, same as STOCK alerts always do.
MARKET_DATA_PROVIDER=binance

# If the real Binance fetch fails: "true" logs a warning and falls back to
# mock candles; "false" (default) fails the worker job (alert -> FAILED).
MARKET_DATA_FALLBACK_TO_MOCK=false

# Telegram notifications. Sent by the WORKER after an alert reaches ANALYZED
# (never inside the webhook request, and never for duplicates).
# Master switch — nothing is sent unless this is "true".
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send the chart screenshot as a photo (with the analysis as caption). Falls
# back to a text-only message if the photo send fails.
TELEGRAM_SEND_SCREENSHOT=true
# Also send a short message when an alert becomes FAILED.
TELEGRAM_NOTIFY_ON_FAILED=false
# Skip the notification when aiConfidence is below this (0..1). 0 = always send.
TELEGRAM_MIN_CONFIDENCE=0

# Bounded data retention (daily cleanup, run by the worker process).
# Master switch - "false" disables the scheduled cleanup entirely (the worker
# keeps running normally); the manual retention:dry-run command still works.
DATA_RETENTION_ENABLED=true
# Screenshots of terminal alerts older than this many days are deleted from
# disk and their reference cleared. The alert row is KEPT and the dashboard
# shows a neutral "Screenshot expired" placeholder.
SCREENSHOT_RETENTION_DAYS=3
# Terminal alerts (ANALYZED/FAILED) older than this many days are deleted
# (TradeReview/TradeJournal rows cascade with them). RECEIVED/PROCESSING
# alerts, and alerts whose trade review is still OPEN/UNREVIEWED, are always
# kept regardless of age.
ALERT_RETENTION_DAYS=7
# When the daily cleanup runs: cron expression, interpreted in
# DATA_CLEANUP_TIMEZONE. Default: 03:00 Singapore time, once per day.
DATA_CLEANUP_CRON=0 3 * * *
DATA_CLEANUP_TIMEZONE=Asia/Singapore

# Dashboard alert-list paging. One page = DASHBOARD_DEFAULT_LIMIT alerts (the
# dashboard's "Load More" button fetches the next page of older retained
# alerts); a single request may ask for at most DASHBOARD_MAX_LIMIT.
DASHBOARD_DEFAULT_LIMIT=100
DASHBOARD_MAX_LIMIT=200
