# PostgreSQL connection used by Prisma (backend + worker)
# Port 55432 matches docker-compose.yml's host mapping (chosen to avoid clashing
# with a locally installed Postgres on the default 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/trading_alert_dashboard?schema=public

# Redis connection used by BullMQ (queue + worker)
REDIS_URL=redis://localhost:6379

# Backend HTTP server
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# OPTIONAL base URL for dashboard links shared outside the app (Telegram
# messages opened on a phone). Set it to your public/tunnel frontend URL to get
# a tappable link in notifications.
# Leave it empty (or unset) when the dashboard is only reachable locally:
# notifications then omit the link section entirely instead of sending a
# localhost URL that cannot be opened from a phone. A localhost/127.0.0.1 value
# is treated the same as empty.
PUBLIC_DASHBOARD_URL=

# Shared secret TradingView must send in the webhook payload
WEBHOOK_SECRET=change-me

# Where generated chart screenshots are written, relative to apps/backend
SCREENSHOT_STORAGE_DIR=src/storage/screenshots

# AI Vision provider: "mock" (default, no API calls) or "openai" (real vision).
AI_VISION_PROVIDER=mock

# OpenAI vision credentials/config. OPENAI_API_KEY is REQUIRED when
# AI_VISION_PROVIDER=openai (startup fails clearly otherwise).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Max time to wait for the AI vision response before aborting.
AI_VISION_TIMEOUT_MS=30000

# If the real AI provider fails: "true" logs a warning and returns a mock
# result; "false" (default) fails the worker job (alert -> FAILED).
AI_VISION_FALLBACK_TO_MOCK=false

# Reject screenshots larger than this many bytes before sending to the AI
# provider (cost/safety guard). Default 5 MB.
AI_VISION_MAX_IMAGE_BYTES=5000000

# Alerts matching symbol+assetType+timeframe+signal+indicatorName within this
# many seconds of an existing alert are suppressed as duplicates instead of
# creating a new alert / screenshot / AI analysis job.
DUPLICATE_SUPPRESSION_WINDOW_SECONDS=60

# Rate limiting (two separate policies).
# Private dashboard reads + /screenshots/* statics. One dashboard load issues
# roughly one screenshot request per alert card (hundreds), so this budget is
# generous on purpose — it is a runaway-loop guard, not a security control
# (the dashboard is private via Tailscale).
DASHBOARD_RATE_LIMIT_MAX=2000
DASHBOARD_RATE_LIMIT_WINDOW=1 minute

# Public TradingView webhook (internet-facing via Cloudflare tunnel). This IS a
# security control and is budgeted independently of dashboard traffic.
WEBHOOK_RATE_LIMIT_MAX=60
WEBHOOK_RATE_LIMIT_WINDOW=1 minute

# Binance public REST API base URL (no API key needed for klines/candles)
BINANCE_REST_BASE_URL=https://api.binance.com

# Binance USD-M Futures REST base URL, used for TradingView ".P" perpetual
# symbols (e.g. BINANCE:GRASSUSDT.P -> /fapi/v1/klines). No API key needed.
# Also the base URL of the read-only connector below.
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com

# --- Binance READ-ONLY connector (Phase 2) -----------------------------------
# Strictly read-only account inspection: only allowlisted GET endpoints can be
# called. It cannot place/cancel orders or change leverage, margin type or
# position mode, and it is NOT wired into the alert pipeline.
#
# Leave disabled (the default) and the backend starts with no Binance keys.
# To use it locally, create a Binance API key with ONLY "Enable Reading"
# permission (no Futures trading, no withdrawals), ideally IP-restricted, and
# put the values in your own .env — never in this example file, never committed.
#   pnpm --filter @trading-alert-dashboard/backend binance:read-only-check
BINANCE_READ_ONLY_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Signed-request validity window in ms. Binance maximum is 60000; default 5000.
BINANCE_RECV_WINDOW_MS=5000
# --- Phase 10 operator maintenance gates (fail-closed) ---
# Strict booleans: only the exact strings "true" or "false" are accepted.
# A typo fails startup rather than silently reading as false.
# Each gate authorizes EXACTLY the one operation it names. Turning both on
# still leaves every live trading gate below closed, so no real trade can be
# placed. See docs/binance-api-key-setup.md.
# Authorizes POST /fapi/v1/positionSide/dual (HEDGE only), and only when the
# whole USDⓈ-M account has zero positions and zero open orders.
BINANCE_ACCOUNT_SETUP_MUTATIONS_ENABLED=false
# Authorizes POST /fapi/v1/order/test — Binance's NON-MATCHING validation
# endpoint. It never reaches the order book and creates no order.
BINANCE_TEST_ORDER_ENABLED=false

# --- Phase 3 dynamic leverage / isolated margin policy (calculation only) ----
# Used by binance:margin-plan to recommend (never apply) a leverage.
# Target isolated margin = risk budget x target multiplier (preferred value).
# Maximum isolated margin = risk budget x max multiplier (hard ceiling; must
# be >= the target multiplier). Liquidation must sit at least
# stopDistance x buffer ratio beyond the stop loss.
BINANCE_TARGET_MARGIN_MULTIPLIER=2.5
BINANCE_MAX_MARGIN_MULTIPLIER=3.333333
# Absolute isolated-margin FLOOR in USD (not a multiplier of the risk budget).
# 0 DISABLES it: no lower bound, and leverage is chosen closest to the target
# margin - the long-standing behaviour. Any positive value rejects candidates
# below it AND switches selection to the smallest margin at or above it.
# Quantity and notional are never increased to reach the floor; only the
# leverage changes. Must not exceed risk budget x max multiplier.
BINANCE_MIN_MARGIN_USD=0
BINANCE_LIQUIDATION_BUFFER_RATIO=0.5
# User-side automation leverage ceiling (positive integer, max 125). Usable
# leverage = min(Binance bracket maximum, this value). Never applied to the
# account - the planner only recommends.
BINANCE_MAX_AUTOMATION_LEVERAGE=25

# --- Phase 5 safety & capacity limits (admission control only) ---------------
# These bound how much NEW exposure the system may admit. They are the locked
# canary limits: every default fails closed.
#
# The kill switch blocks NEW admissions ONLY. It NEVER cancels an order, closes
# a position, changes the status of an existing execution, or deletes capacity
# records. Turning it on mid-flight leaves everything already running exactly
# as it is.
#
# true = kill switch ACTIVE (every admission rejected). Only the exact string
# "false" releases it; unset or anything else is a configuration error.
EXECUTION_GLOBAL_KILL_SWITCH=true
# Positive integers. Reaching a limit only skips the REQUESTING execution -
# existing executions, positions and orders are never touched.
EXECUTION_MAX_OPEN_POSITIONS=1
EXECUTION_MAX_PENDING_ENTRIES=1
# Must be >= both limits above, otherwise startup fails validation.
EXECUTION_MAX_TOTAL_ACTIVE_TRADES=1
# Decimal strings (never parsed as floats). Risk is reserved at the FULL risk
# budget and margin at the MAXIMUM isolated margin, not the smaller estimates.
EXECUTION_MAX_TOTAL_PLANNED_RISK_USD=1.50
EXECUTION_MAX_TOTAL_ISOLATED_MARGIN_USD=5.00
# At most this many active executions per symbol AND side (LONG/SHORT).
EXECUTION_MAX_ACTIVE_PER_SYMBOL_SIDE=1
# Freshness is measured from the ORIGINAL signal time (Alert.triggeredAt frozen
# onto the execution), never from when the row was created.
EXECUTION_MAX_ALERT_AGE_SECONDS=300
# Tolerance for a signal timestamp slightly ahead of local time (clock skew).
EXECUTION_SIGNAL_FUTURE_TOLERANCE_SECONDS=5

# --- Phase 6 LIMIT entry lifecycle (live entry is OFF by default) ------------
# Phase 6 is the first phase able to mutate Binance state. BOTH gates below
# must be exactly "true" before any POST/DELETE is dispatched. Phase 7
# protection does not exist yet, so EXECUTION_PROTECTION_READY stays false and
# NO real entry can be placed. With either gate false the lifecycle makes zero
# mutation calls, reserves no order and changes no execution status.
#
# Only the exact string "true" opens a gate; unset stays closed and any other
# value is a startup validation failure.
EXECUTION_LIVE_ENTRY_ENABLED=false
EXECUTION_PROTECTION_READY=false
# Local time-to-live for an unfilled LIMIT entry. The order is sent GTC; this
# is our own deadline, after which the REMAINDER is cancelled. A partial fill
# is never closed or reversed - it becomes MANUAL_INTERVENTION until Phase 7.
EXECUTION_ENTRY_TTL_SECONDS=86400
# Bounded reconciliation budget for an ambiguous submit/cancel result. A
# timeout is never proof that nothing happened, so the same clientOrderId is
# queried rather than a new order being created.
EXECUTION_ENTRY_RECONCILE_MAX_ATTEMPTS=5
EXECUTION_ENTRY_RECONCILE_DELAY_MS=1000

# --- Phase 7 SL/TP protection, margin top-up and emergency close ------------
# Protection is placed through the Algo Order API (conditional STOP_MARKET /
# TAKE_PROFIT_MARKET). Every Phase 7 mutation is RISK-REDUCING, so it is not
# gated on the live-entry switches above: refusing to protect or close an
# existing position because new entries were disabled would be the opposite of
# safe. EXECUTION_PROTECTION_READY stays false, so no real entry is placed at
# all during development.
#
# Adding isolated margin moves real balance, so it is off by default. The total
# verified isolated margin can never exceed the frozen maximumIsolatedMargin.
EXECUTION_AUTO_ADD_MARGIN_ENABLED=false
# DISABLED: never send a MARKET close - park for a human instead.
# ON_UNVERIFIED_STOP: last-resort close when the stop cannot be verified after
# bounded reconciliation and no verified stop covers the position.
EXECUTION_EMERGENCY_CLOSE_MODE=DISABLED
# Bounded budget for resolving an ambiguous protection submit/cancel. A timeout
# is never proof of failure: the same clientAlgoId is queried instead.
EXECUTION_PROTECTION_RECONCILE_MAX_ATTEMPTS=5
EXECUTION_PROTECTION_RECONCILE_DELAY_MS=1000
# Both protection legs trigger on the traded contract price (Last Price), so
# they fire against the same feed the chart levels were drawn from.
EXECUTION_SL_WORKING_TYPE=CONTRACT_PRICE
EXECUTION_TP_WORKING_TYPE=CONTRACT_PRICE
EXECUTION_PROTECTION_PRICE_PROTECT=false

# Market data provider for CRYPTO alerts on the BINANCE exchange. Currently
# only "binance" (real klines) is implemented; anything else falls back to
# mock candles, same as STOCK alerts always do.
MARKET_DATA_PROVIDER=binance

# If the real Binance fetch fails: "true" logs a warning and falls back to
# mock candles; "false" (default) fails the worker job (alert -> FAILED).
MARKET_DATA_FALLBACK_TO_MOCK=false

# Telegram notifications. Sent by the WORKER after an alert reaches ANALYZED
# (never inside the webhook request, and never for duplicates).
# Master switch — nothing is sent unless this is "true".
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send the chart screenshot as a photo (with the analysis as caption). Falls
# back to a text-only message if the photo send fails.
TELEGRAM_SEND_SCREENSHOT=true
# Also send a short message when an alert becomes FAILED.
TELEGRAM_NOTIFY_ON_FAILED=false
# Skip the notification when aiConfidence is below this (0..1). 0 = always send.
TELEGRAM_MIN_CONFIDENCE=0
# Phase 9 — OPTIONAL separate destination for execution milestone messages
# (LIMIT PLACED / PARTIAL FILL / POSITION FILLED / POSITION PROTECTED / ENTRY
# EXPIRED / CLOSED / TRADE SKIPPED). Leave empty to send them to
# TELEGRAM_CHAT_ID alongside the signal notifications. The SAME
# TELEGRAM_BOT_TOKEN is used either way — there is no second bot.
# Critical protection alerts always go to TELEGRAM_CHAT_ID and are never
# duplicated into this chat.
# Accepted forms: a numeric chat id ("-1001234567890") or "@channel_name".
TELEGRAM_EXECUTION_CHAT_ID=

# Bounded data retention (daily cleanup, run by the worker process).
# Master switch - "false" disables the scheduled cleanup entirely (the worker
# keeps running normally); the manual retention:dry-run command still works.
DATA_RETENTION_ENABLED=true
# Screenshots of terminal alerts older than this many days are deleted from
# disk and their reference cleared. The alert row is KEPT and the dashboard
# shows a neutral "Screenshot expired" placeholder.
SCREENSHOT_RETENTION_DAYS=3
# Terminal alerts (ANALYZED/FAILED) older than this many days are deleted
# (TradeReview/TradeJournal rows cascade with them). RECEIVED/PROCESSING
# alerts, and alerts whose trade review is still OPEN/UNREVIEWED, are always
# kept regardless of age.
ALERT_RETENTION_DAYS=7
# When the daily cleanup runs: cron expression, interpreted in
# DATA_CLEANUP_TIMEZONE. Default: 03:00 Singapore time, once per day.
DATA_CLEANUP_CRON=0 3 * * *
DATA_CLEANUP_TIMEZONE=Asia/Singapore

# Dashboard alert-list paging. One page = DASHBOARD_DEFAULT_LIMIT alerts (the
# dashboard's "Load More" button fetches the next page of older retained
# alerts); a single request may ask for at most DASHBOARD_MAX_LIMIT.
DASHBOARD_DEFAULT_LIMIT=100
DASHBOARD_MAX_LIMIT=200
