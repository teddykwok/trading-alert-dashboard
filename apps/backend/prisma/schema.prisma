generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  CRYPTO
  STOCK
}

enum SignalType {
  LONG
  SHORT
  WATCH
  EXIT
}

enum AlertStatus {
  RECEIVED
  PROCESSING_SCREENSHOT
  ANALYZING_WITH_AI
  ANALYZED
  FAILED
  IGNORED_DUPLICATE
}

enum TradeReviewStatus {
  UNREVIEWED
  IGNORED
  OPEN
  WIN
  LOSS
  BREAKEVEN
}

enum TradeMarginMode {
  ISOLATED
  CROSS
}

enum TradeEmotion {
  CALM
  ANXIOUS
  EXCITED
  FRUSTRATED
  TIRED
  FOMO
  REVENGE
  UNCERTAIN
}

enum ExtremeRRPlanStatus {
  PENDING
  READY
  INVALID
  ERROR
}

// Telegram delivery state for a plan's ONE lifecycle notification. Null means
// "not attempted yet"; SENDING is a short-lived atomic claim that makes
// concurrent/retried worker attempts idempotent (claim via updateMany, only
// null/FAILED are claimable).
enum ExtremeRRTelegramStatus {
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum AlertEventType {
  LEVEL_CREATED
  LEVEL_TOUCHED
}

enum LevelColor {
  GREEN
  RED
}

enum TouchDirection {
  FROM_ABOVE
  FROM_BELOW
  UNKNOWN
}

model Asset {
  id        String    @id @default(cuid())
  symbol    String
  name      String?
  assetType AssetType
  exchange  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  alerts    Alert[]

  @@unique([symbol, assetType])
}

model Alert {
  id              String      @id @default(cuid())
  assetId         String?
  asset           Asset?      @relation(fields: [assetId], references: [id])
  symbol          String
  assetType       AssetType
  exchange        String?
  timeframe       String
  price           Float
  signal          SignalType
  indicatorName   String?
  indicatorValue  Float?
  rawPayload      Json
  // Level context parsed once from the webhook note at ingestion. All
  // nullable: pre-existing alerts and notes without metadata leave them null
  // (API responses then fall back to parsing the note in rawPayload).
  // sourceTimeframe is a validated string ("1D".."12M") rather than an enum
  // because values like "12M" can't be Prisma enum members. It is the
  // timeframe the LEVEL originated on — `timeframe` above remains the chart
  // timeframe; the two must never be conflated.
  eventType       AlertEventType?
  levelColor      LevelColor?
  sourceTimeframe String?
  touchDirection  TouchDirection?
  status          AlertStatus @default(RECEIVED)
  screenshotUrl   String?
  aiBias          String?
  aiConfidence    Float?
  aiPattern       String?
  aiSummary       String?
  aiRiskNotes     Json?
  aiProvider      String?
  duplicateCount  Int         @default(0)
  lastDuplicateAt DateTime?
  errorMessage    String?
  triggeredAt     DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tradeReview     TradeReview?
  tradeJournal    TradeJournal?
  extremeRRPlan   ExtremeRRPlan?
  tradeExecutions TradeExecution[]
  selectedPlanOutcome SelectedPlanOutcome?

  @@index([status])
  @@index([symbol])
  @@index([signal])
  @@index([createdAt])
  @@index([symbol, assetType, timeframe, signal, indicatorName])
  @@index([sourceTimeframe])
  @@index([levelColor])
}

// Manual live-outcome tracking: one review per alert, filled in by the user
// after the fact (ignored / opened / won / lost / breakeven). Deliberately a
// separate one-to-one model so mutable trading fields don't live on the
// immutable-ish Alert row. Prices are Decimal (not Float) to preserve
// small-cap precision like 0.004086 exactly.
model TradeReview {
  id         String            @id @default(cuid())
  alertId    String            @unique
  alert      Alert             @relation(fields: [alertId], references: [id], onDelete: Cascade)
  status     TradeReviewStatus @default(UNREVIEWED)
  entryPrice Decimal?          @db.Decimal(30, 12)
  exitPrice  Decimal?          @db.Decimal(30, 12)
  notes      String?
  openedAt   DateTime?
  closedAt   DateTime?

  // Futures risk-planner INPUTS only. Derived values (risk budget, quantity,
  // notional, required margin, R:R, expected profit, …) are deliberately NOT
  // stored — they are recalculated from these inputs on every read so they
  // can never drift out of sync.
  stopLossPrice    Decimal?         @db.Decimal(30, 12)
  takeProfitPrice  Decimal?         @db.Decimal(30, 12)
  accountBalance   Decimal?         @db.Decimal(30, 12)
  riskPercent      Decimal?         @db.Decimal(10, 6)
  leverage         Decimal?         @db.Decimal(10, 4)
  marginMode       TradeMarginMode?
  liquidationPrice Decimal?         @db.Decimal(30, 12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Pre-trade checklist + psychology journal: one journal per alert, filled in
// manually by the user. Separate from TradeReview for the same reason
// TradeReview is separate from Alert — a distinct concern with its own
// lifecycle. Derived values (completed count, percentage, completeness) are
// deliberately NOT stored; they are recomputed from the booleans on every
// read so they can never drift. No score of any kind is stored or computed.
// Checklist keys mirror TRADE_CHECKLIST_ITEMS in packages/shared.
model TradeJournal {
  id      String @id @default(cuid())
  alertId String @unique
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  // Pre-trade checklist (unchecked by default).
  signalMatchesPlan      Boolean @default(false)
  entryStopTargetDefined Boolean @default(false)
  riskWithinLimit        Boolean @default(false)
  leverageReviewed       Boolean @default(false)
  notFomo                Boolean @default(false)
  notRevengeTrade        Boolean @default(false)
  acceptsPotentialLoss   Boolean @default(false)

  // Psychology — all self-reported, all optional.
  emotion             TradeEmotion?
  confidenceLevel     Int? // 1–5, validated at the API boundary
  reasonForEntry      String? @db.Text
  preTradeNotes       String? @db.Text
  postTradeReflection String? @db.Text
  lessonLearned       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emotion])
}

// Step-based fixed-capital money management: referenceCapital is a manually
// chosen planning value (e.g. 400), NEVER synced from any exchange balance or
// PnL — the user edits it explicitly when stepping up/down. Derived amounts
// (riskAmount, targetAmount) are deliberately NOT stored; the API recomputes
// them from these fields on every read so they can never drift. At most one
// template is active at a time, enforced transactionally at activation.
model RiskTemplate {
  id               String   @id @default(cuid())
  name             String
  referenceCapital Decimal  @db.Decimal(30, 12)
  riskPercent      Decimal  @db.Decimal(10, 6)
  rewardRatio      Decimal  @db.Decimal(10, 4)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

// One authoritative Extreme RR plan per alert (unique alertId). Everything a
// plan needs to be reproduced is snapshotted at generation time: the entry
// (alert price), the candle cutoff (alert triggeredAt), the risk-template
// values, and the three frozen lookback candidates (100/200/300 closed
// candles ending before the cutoff, as JSON of exact decimal strings).
// Candidates NEVER drift with later market prices; money-management numbers
// are recomputed on read from these frozen fields only — never from an
// exchange balance and never accepted from a client.
model ExtremeRRPlan {
  id         String              @id @default(cuid())
  alertId    String              @unique
  alert      Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  status     ExtremeRRPlanStatus @default(PENDING)
  direction  SignalType
  entryBasis String              @default("ALERT_PRICE")
  entryPrice Decimal             @db.Decimal(30, 12)
  cutoffAt   DateTime
  timeframe  String
  marketType String?

  // Risk-template snapshot at generation time (all null when none was
  // active). Later template edits must never mutate an existing plan.
  riskTemplateId   String?
  templateName     String?
  referenceCapital Decimal? @db.Decimal(30, 12)
  riskPercent      Decimal? @db.Decimal(10, 6)
  rewardRatio      Decimal? @db.Decimal(10, 4)
  riskAmount       Decimal? @db.Decimal(30, 12)
  targetAmount     Decimal? @db.Decimal(30, 12)

  // Frozen lookback candidates (see ExtremeRRCandidate in packages/shared).
  candidates       Json?
  selectedLookback Int     @default(300)
  selectedLeverage Int?

  errorReason String?
  generatedAt DateTime?

  // One Telegram notification per plan lifecycle (READY / INVALID / final
  // ERROR). Reset when a plan is explicitly regenerated so the new outcome
  // notifies again. telegramLastError never contains tokens or chat ids.
  telegramStatus     ExtremeRRTelegramStatus?
  telegramNotifiedAt DateTime?
  telegramLastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradeExecutions TradeExecution[]
  selectedPlanOutcome SelectedPlanOutcome?

  @@index([status])
}

// ===========================================================================
// Phase 4 — Execution database and lifecycle foundation.
//
// DATABASE AND LIFECYCLE ONLY. Nothing in this phase submits, cancels or
// modifies anything on Binance: BinanceOrder rows are LOCAL reservations, and
// no model stores an API key, secret, signature, signed URL or raw exchange
// payload. Phase 2 stays GET-only; Phase 3 stays calculation-only.
// ===========================================================================

enum ExecutionExchange {
  BINANCE
}

enum ExecutionProduct {
  USD_M_FUTURES
}

enum ExecutionEnvironment {
  MAINNET
  TESTNET
}

enum ExecutionPositionMode {
  HEDGE
  ONE_WAY
}

enum ExecutionMarginType {
  ISOLATED
  CROSS
}

enum ExecutionOrderType {
  LIMIT
  MARKET
  STOP_MARKET
  TAKE_PROFIT_MARKET
}

enum ExecutionDirection {
  LONG
  SHORT
}

enum ExecutionPositionSide {
  LONG
  SHORT
  BOTH
}

enum ExecutionOrderSide {
  BUY
  SELL
}

 // Lifecycle of one planned execution. FAILED means no unresolved live
 // exposure is known; whenever exposure may exist and protection is uncertain
 // the correct state is MANUAL_INTERVENTION. CANCELED is only for an execution
 // canceled before any live exposure.
enum TradeExecutionStatus {
  PLAN_READY
  PREFLIGHT
  ENTRY_SUBMITTING
  ENTRY_PENDING
  PARTIALLY_FILLED
  ENTRY_FILLED
  PLACING_PROTECTION
  PROTECTED
  ENTRY_EXPIRED
  CLOSED_TP
  CLOSED_SL
  CANCELED
  SKIPPED
  FAILED
  MANUAL_INTERVENTION
  /// Phase 7: exposure was closed by the last-resort emergency MARKET close.
  CLOSED_EMERGENCY
  /// The position is PROVEN flat but the closure cannot be attributed to one
  /// of our owned, verified orders: a manual operator close, another client, a
  /// liquidation or ADL are indistinguishable from here. Claims only what is
  /// known rather than inventing a cause.
  CLOSED_EXTERNAL
}

enum ExecutionOrderRole {
  ENTRY
  STOP_LOSS
  TAKE_PROFIT
  EMERGENCY_CLOSE
}

enum ExecutionOrderStatus {
  PLANNED
  SUBMITTING
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
  EXPIRED
  REJECTED
  UNKNOWN
}

enum ExecutionEventType {
  EXECUTION_CREATED
  STATUS_CHANGED
  ORDER_RESERVED
  ORDER_UPDATED
  PLAN_SNAPSHOT_RECORDED
  ACTUALS_UPDATED
  DECISION_RECORDED
  FAILURE_RECORDED
  MANUAL_INTERVENTION_REQUIRED
  // --- Phase 6 entry lifecycle ---
  EXCHANGE_CONFIG_VERIFIED
  ENTRY_SUBMITTED
  ENTRY_RECONCILED
  ENTRY_CANCEL_REQUESTED
  // --- Phase 7 protection lifecycle ---
  PROTECTION_RESERVED
  PROTECTION_SUBMITTED
  PROTECTION_VERIFIED
  PROTECTION_RECONCILED
  MARGIN_ADJUSTED
  EMERGENCY_CLOSE_SUBMITTED
  PROTECTION_CLEANUP
  CRITICAL_ALERT_RAISED
}

 // Non-secret execution/account configuration. `accountIdentifier` is an opaque
 // user-chosen alias (e.g. "primary-futures"); it is NEVER an API key, secret
 // or any credential, and no credential column exists on this model. Profiles
 // default to disabled so nothing can be treated as live by accident.
model ExecutionProfile {
  id                   String                @id @default(cuid())
  name                 String
  accountIdentifier    String
  exchange             ExecutionExchange     @default(BINANCE)
  product              ExecutionProduct      @default(USD_M_FUTURES)
  environment          ExecutionEnvironment  @default(TESTNET)
  isEnabled            Boolean               @default(false)
  expectedPositionMode ExecutionPositionMode @default(HEDGE)
  expectedMarginType   ExecutionMarginType   @default(ISOLATED)
  entryOrderType       ExecutionOrderType    @default(LIMIT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  executions   TradeExecution[]
  safetyPolicy ExecutionSafetyPolicy?
  canaryAuthorizations ExecutionCanaryAuthorization[]

  @@unique([exchange, environment, accountIdentifier])
  @@index([isEnabled])
  tradingSessions   TradingSession[]
}

// Phase 5 — per-profile safety and capacity limits.
//
// Fails closed by design: killSwitchActive defaults TRUE and every limit
// defaults to the canary value, so a freshly created policy admits nothing
// until it is deliberately relaxed. Stores no credential of any kind.
//
// The kill switch blocks NEW admissions only. It never cancels an order,
// closes a position, changes an existing execution status or deletes capacity
// records — see docs/binance-execution-policy.md.
model ExecutionSafetyPolicy {
  id                 String           @id @default(cuid())
  executionProfileId String           @unique
  executionProfile   ExecutionProfile @relation(fields: [executionProfileId], references: [id], onDelete: Restrict)

  killSwitchActive Boolean @default(true)

  maxOpenPositions      Int @default(1)
  maxPendingEntries     Int @default(1)
  maxTotalActiveTrades  Int @default(1)
  maxActivePerSymbolSide Int @default(1)
  maxAlertAgeSeconds    Int @default(300)

  // SOFT admission target for open positions, distinct from the HARD
  // maxOpenPositions above. Reaching it closes NEW admission and asks the
  // orchestrator to cancel remaining live ENTRY orders — it is NEVER a
  // post-fill validity rule. Positions that fill while cancellation is in
  // flight stay valid up to maxOpenPositions and are protected normally.
  // Must be <= maxOpenPositions. Defaults to 1 so existing behaviour (soft ==
  // hard == 1) is unchanged until an operator raises it.
  softOpenPositionTarget Int @default(1)

  maxTotalPlannedRiskUsd    Decimal @default("1.50") @db.Decimal(30, 12)
  maxTotalIsolatedMarginUsd Decimal @default("5.00") @db.Decimal(30, 12)

  // Empty array = no additional user restriction; non-empty = allowlist only.
  allowedSymbols String[] @default([])

  // Which SOURCE timeframes (the timeframe the level originated on, never the
  // chart timeframe the retest fired on) may create a live execution.
  //
  // Read the emptiness rule the OPPOSITE way to allowedSymbols above. There,
  // empty means no extra restriction; here empty admits NOTHING, because the
  // engine asks whether the list CONTAINS the signal's timeframe and an empty
  // list contains nothing. That asymmetry is deliberate: an allowlist that
  // silently means all is a footgun this repository already owns once, and it
  // is not being reproduced for execution eligibility.
  //
  // The default names all six supported timeframes so existing behaviour —
  // every source timeframe was eligible — is preserved exactly.
  allowedSourceTimeframes String[] @default(["1D", "1W", "1M", "3M", "6M", "12M"])

  // How many closed candles a NEW Extreme RR plan searches for its extreme.
  //
  // This is the INITIAL selection for a new plan only. Every supported
  // lookback is still calculated and frozen on the plan, and the per-alert
  // planner can still switch between them — so changing this value never
  // reaches a plan that already exists, and never reaches an execution.
  //
  // 300 is the pre-feature behaviour and therefore the default. A value
  // outside 50/100/200/300 is invalid configuration, not a request to fall
  // back: planning refuses rather than quietly using 300.
  extremeRrLookbackCandles Int @default(300)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SafetyDecision {
  PASS
  SKIP
  RETRY_CONFLICT
  UNAVAILABLE
}

// Sanitized audit record of one admission evaluation. Holds decision inputs
// and projected totals only — never credentials, signed URLs, auth headers or
// raw Binance payloads, and no unrelated position/account detail.
//
// RESTRICT on the execution: this is financial/audit history and must not be
// removed implicitly.
model SafetyAdmission {
  id               String         @id @default(cuid())
  tradeExecutionId String
  tradeExecution   TradeExecution @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  // One decision per evaluated version, so idempotent retries cannot duplicate history.
  evaluatedVersion Int
  evaluatedAt      DateTime
  decision         SafetyDecision
  reasonCode       String?
  message          String?
  signalAgeSeconds Int?

  effectiveLimits  Json?
  capacityBefore   Json?
  capacityProjected Json?
  reservedRiskUsd    Decimal? @db.Decimal(30, 12)
  reservedMarginUsd  Decimal? @db.Decimal(30, 12)
  symbolStateSummary Json?
  binanceSnapshotAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([tradeExecutionId, evaluatedVersion])
  @@index([tradeExecutionId])
  @@index([decision])
}

 // One planned execution derived from one frozen Extreme RR + margin plan.
 //
 // The planned block is IMMUTABLE once created — lifecycle services never
 // rewrite it; only the nullable actual/result fields are updated by later
 // reconciliation phases. `version` drives optimistic locking and also
 // supplies the strictly increasing ExecutionEvent sequence.
 //
 // Deletion policy (financial/audit data):
 //  - alert / extremeRRPlan use SET NULL so bounded retention can delete old
 //    alerts WITHOUT destroying execution history (the row stays self-contained
 //    via denormalized symbol/direction and the frozen snapshots);
 //  - executionProfile uses RESTRICT so a profile with history cannot be
 //    removed;
 //  - orders and events use RESTRICT so an execution with either cannot be
 //    deleted implicitly.
model TradeExecution {
  id                 String                @id @default(cuid())
  executionProfileId String
  executionProfile   ExecutionProfile      @relation(fields: [executionProfileId], references: [id], onDelete: Restrict)
  alertId            String?
  alert              Alert?                @relation(fields: [alertId], references: [id], onDelete: SetNull)
  extremeRRPlanId    String?
  extremeRRPlan      ExtremeRRPlan?        @relation(fields: [extremeRRPlanId], references: [id], onDelete: SetNull)

  symbol           String
  direction        ExecutionDirection
  positionSide     ExecutionPositionSide
  selectedLookback Int
  // Frozen copy of Alert.triggeredAt — the ORIGINAL signal time, used for
  // freshness admission. Kept on the execution so it survives retention
  // nulling alertId. Nullable only because rows created before Phase 5 have
  // no trustworthy value; those fail closed with SIGNAL_TIME_UNAVAILABLE
  // rather than being backfilled with a fabricated timestamp.
  signalTriggeredAt DateTime?
  // Frozen copy of Alert.sourceTimeframe — the timeframe the LEVEL originated
  // on. Kept on the execution for the same reason signalTriggeredAt is:
  // retention may null alertId, and an admission input that can disappear is
  // not an admission input. Nullable because rows created before this column
  // existed have no trustworthy value, and because an alert whose note carried
  // no recognised sourceTf legitimately has none; both fail closed at admission
  // with SOURCE_TIMEFRAME_UNAVAILABLE rather than being backfilled with a guess.
  sourceTimeframe   String?
  status           TradeExecutionStatus  @default(PLAN_READY)
  version          Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // --- Frozen planned values (immutable after creation) --------------------
  plannedEntryPrice          Decimal  @db.Decimal(30, 12)
  calculatedStopLoss         Decimal  @db.Decimal(30, 12)
  executableStopLoss         Decimal  @db.Decimal(30, 12)
  takeProfit                 Decimal? @db.Decimal(30, 12)
  riskBudgetUsd              Decimal  @db.Decimal(30, 12)
  quantityRaw                Decimal  @db.Decimal(40, 18)
  plannedQuantity            Decimal  @db.Decimal(40, 18)
  quantityStepSize           Decimal  @db.Decimal(40, 18)
  actualPlannedLoss          Decimal  @db.Decimal(30, 12)
  unusedRiskBudget           Decimal  @db.Decimal(30, 12)
  positionNotional           Decimal  @db.Decimal(30, 12)
  targetIsolatedMargin       Decimal  @db.Decimal(30, 12)
  maximumIsolatedMargin      Decimal  @db.Decimal(30, 12)
  selectedLeverage           Int
  estimatedInitialMargin     Decimal  @db.Decimal(30, 12)
  estimatedLiquidationPrice  Decimal? @db.Decimal(30, 12)
  requiredLiquidationBoundary Decimal? @db.Decimal(30, 12)
  liquidationBufferRatio     Decimal  @db.Decimal(10, 4)
  estimatedRewardRatio       Decimal? @db.Decimal(10, 4)
  entryExpiresAt             DateTime?

  // --- Frozen sanitized snapshots (exact decimal strings, no raw payloads) --
  extremeRRCandidateSnapshot Json?
  marginPlanSnapshot         Json?
  riskTemplateSnapshot       Json?
  exchangeFiltersSnapshot    Json?

  // --- Actual/result values (null until later execution phases) ------------
  submittedEntryPrice      Decimal? @db.Decimal(30, 12)
  averageFillPrice         Decimal? @db.Decimal(30, 12)
  filledQuantity           Decimal? @db.Decimal(40, 18)
  actualLeverage           Int?
  actualIsolatedMargin     Decimal? @db.Decimal(30, 12)
  reportedLiquidationPrice Decimal? @db.Decimal(30, 12)
  actualExitPrice          Decimal? @db.Decimal(30, 12)
  realizedPnl              Decimal? @db.Decimal(30, 12)
  /// Phase 8 journal. Both are NULLABLE and null means "unknown / not yet
  /// collected" — never zero. Nothing in this repository estimates them, and
  /// no historical Binance fetch exists, so they stay null until a future
  /// phase records real values.
  /// Non-negative total trading fees paid.
  tradingFeesUsd           Decimal? @db.Decimal(30, 12)
  /// Signed funding PnL: positive = received, negative = paid.
  fundingPnlUsd            Decimal? @db.Decimal(30, 12)
  exitReason               String?
  entrySubmittedAt         DateTime?
  firstFillAt              DateTime?
  entryFilledAt            DateTime?
  protectionPlacedAt       DateTime?
  closedAt                 DateTime?

  // --- Failure / decision (sanitized text only, never stack traces) --------
  decisionReasonCode        String?
  sanitizedMessage          String?
  requiresManualIntervention Boolean  @default(false)
  lastReconciledAt          DateTime?

  orders            BinanceOrder[]
  events            ExecutionEvent[]
  safetyAdmissions  SafetyAdmission[]
  protectionState   ExecutionProtectionState?
  marginAdjustments MarginAdjustmentIntent[]
  criticalAlerts    CriticalAlert[]
  notifications     ExecutionNotification[]
  protectionVerifications ExecutionProtectionVerification[]

  @@unique([alertId, executionProfileId])
  @@index([status])
  @@index([executionProfileId])
  @@index([symbol])
  // Phase 8 journal lists default to "most recently updated first"; status,
  // profile, symbol and (alertId, profile) are already covered above.
  @@index([updatedAt])
}

 // LOCAL representation of an order this project may later submit. Creating a
 // row here sends nothing to Binance — Phase 4 has no submission path at all.
 // `generation` allows replacement orders (e.g. a re-placed stop) to coexist
 // as distinct historical rows.
model BinanceOrder {
  id               String               @id @default(cuid())
  tradeExecutionId String
  tradeExecution   TradeExecution       @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  role             ExecutionOrderRole
  generation       Int                  @default(1)
  /// Deterministic, non-identifying local id (Binance: ^[\.A-Z\:/a-z0-9_-]{1,36}$).
  clientOrderId    String               @unique
  exchangeOrderId  String?
  side             ExecutionOrderSide
  positionSide     ExecutionPositionSide
  orderType        ExecutionOrderType
  timeInForce      String?
  price            Decimal?             @db.Decimal(30, 12)
  stopPrice        Decimal?             @db.Decimal(30, 12)
  originalQuantity Decimal              @db.Decimal(40, 18)
  executedQuantity Decimal              @default(0) @db.Decimal(40, 18)
  averageFillPrice Decimal?             @db.Decimal(30, 12)
  status           ExecutionOrderStatus @default(PLANNED)
  reduceOnly       Boolean?
  closePosition    Boolean?
  submittedAt      DateTime?
  lastExchangeUpdateAt DateTime?

  // --- Phase 6 entry lifecycle --------------------------------------------
  // Durable TTL deadline for THIS order. Deliberately NOT TradeExecution
  // .entryExpiresAt, which sits in the frozen planned block and means "the
  // plan's entry opportunity expires" — a different thing, decided before any
  // order exists. Derived once from the committed submission intent and then
  // stable across every retry.
  entryOrderExpiresAt  DateTime?
  /// Set when a submission returned an ambiguous result (timeout / 5xx).
  submissionUnknownAt  DateTime?
  cancelRequestedAt    DateTime?
  cancelConfirmedAt    DateTime?
  /// Bounded reconciliation accounting — never a raw Binance payload.
  reconcileAttempts    Int                 @default(0)
  lastReconcileAt      DateTime?
  /// Binance's own status string (e.g. "EXPIRED_IN_MATCH") kept verbatim for
  /// audit when it does not map 1:1 onto ExecutionOrderStatus.
  exchangeStatusRaw    String?

  // --- Phase 7 conditional (Algo) protection identity ----------------------
  /// Deterministic id for POST/GET/DELETE /fapi/v1/algoOrder. Unique, so a
  /// retry can never create a second protection order.
  clientAlgoId         String?              @unique
  /// Binance algoId, persisted only once it has actually been observed.
  exchangeAlgoId       String?
  /// Binance algoStatus verbatim — normalized separately from order status.
  algoStatus           String?
  /// The standard order id created when the conditional order triggers.
  actualOrderId        String?
  triggerPrice         Decimal?             @db.Decimal(30, 12)
  workingType          String?
  priceProtect         Boolean?
  triggeredAt          DateTime?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([tradeExecutionId, role, generation])
  @@index([tradeExecutionId])
  @@index([status])
}

 // Append-only lifecycle history. The service never updates or deletes an
 // event. `sequenceNumber` is strictly increasing per execution and is written
 // in the same transaction as the status change it describes. `metadata` is
 // sanitized before storage — credential-like keys are rejected/redacted and
 // raw Binance payloads are never stored.
model ExecutionEvent {
  id               String             @id @default(cuid())
  tradeExecutionId String
  tradeExecution   TradeExecution     @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  sequenceNumber   Int
  eventType        ExecutionEventType
  fromStatus       TradeExecutionStatus?
  toStatus         TradeExecutionStatus?
  reasonCode       String?
  message          String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  /// Phase 9 materialization ledger entry (derived, never authoritative).
  notificationCheckpoint ExecutionNotificationCheckpoint?

  @@unique([tradeExecutionId, sequenceNumber])
  @@index([tradeExecutionId, sequenceNumber])
  @@index([eventType])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// Phase 7 — SL/TP protection, liquidation safety, margin top-up, emergency close
// ===========================================================================

/// Protection lifecycle, tracked SEPARATELY from TradeExecution.status.
/// The entry can still be PARTIALLY_FILLED (and must keep consuming its
/// pending-entry capacity) while the already-filled quantity is fully
/// protected — overloading TradeExecution.PROTECTED would hide that.
enum ProtectionState {
  UNPROTECTED
  MARGIN_CHECK
  MARGIN_ADJUSTING
  PLACING_STOP
  STOP_VERIFIED
  PLACING_TAKE_PROFIT
  PROTECTED
  PROTECTION_INCOMPLETE
  EMERGENCY_CLOSING
  CLOSURE_CLEANUP
  CLOSED
  MANUAL_INTERVENTION
}

model ExecutionProtectionState {
  id               String          @id @default(cuid())
  tradeExecutionId String          @unique
  tradeExecution   TradeExecution  @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  state            ProtectionState @default(UNPROTECTED)

  /// Absolute open position quantity confirmed from positionRisk.
  confirmedOpenQuantity       Decimal @default(0) @db.Decimal(40, 18)
  /// Aggregate VERIFIED active coverage across every generation.
  protectedStopQuantity       Decimal @default(0) @db.Decimal(40, 18)
  protectedTakeProfitQuantity Decimal @default(0) @db.Decimal(40, 18)
  /// Highest protection tranche reserved so far (0 = none).
  currentGeneration           Int     @default(0)

  /// Result of revalidating the ACTUAL liquidation price against the frozen
  /// boundary. Null means "not yet established" and never means "safe".
  liquidationSafe Boolean?
  verifiedAt      DateTime?

  reasonCode       String?
  sanitizedMessage String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

enum MarginAdjustmentStatus {
  PENDING
  SUBMITTING
  RESULT_UNKNOWN
  CONFIRMED
  REJECTED
}

/// One durable ADD-margin intent. Written BEFORE the POST so an ambiguous
/// result can be reconciled against a known baseline instead of being retried
/// blind. Only type=1 (ADD) is representable.
model MarginAdjustmentIntent {
  id               String         @id @default(cuid())
  tradeExecutionId String
  tradeExecution   TradeExecution @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  /// Deterministic per execution: attempt N is unique, so a retry cannot
  /// silently become a second ADD.
  attempt          Int
  symbol           String
  positionSide     ExecutionPositionSide
  /// Always 1 (ADD). Margin removal has no representation anywhere.
  adjustType       Int            @default(1)
  amount           Decimal        @db.Decimal(30, 12)

  /// Pre-adjustment snapshot used to prove whether the ADD landed.
  baselineIsolatedMargin   Decimal? @db.Decimal(30, 12)
  baselinePositionAmt      Decimal? @db.Decimal(40, 18)
  baselineLiquidationPrice Decimal? @db.Decimal(30, 12)

  status                 MarginAdjustmentStatus @default(PENDING)
  verifiedIsolatedMargin Decimal?               @db.Decimal(30, 12)
  reasonCode             String?
  requestedAt            DateTime?
  resolvedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tradeExecutionId, attempt])
  @@index([tradeExecutionId])
  @@index([status])
}

enum CriticalAlertStatus {
  PENDING
  SENT
  FAILED
}

/// Durable outbox for critical protection alerts. Safety actions never wait
/// for delivery, and a delivery failure stays visible and retryable. Content
/// is sanitized: no credentials, signed URLs, balances, unrelated positions or
/// raw Binance payloads.
model CriticalAlert {
  id               String         @id @default(cuid())
  tradeExecutionId String
  tradeExecution   TradeExecution @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  alertType        String
  reasonCode       String
  /// Stable per (execution, type, reason, state) so repeated reconciliation
  /// cannot spam identical alerts.
  dedupeKey        String              @unique
  message          String
  details          Json?
  status           CriticalAlertStatus @default(PENDING)
  attempts         Int                 @default(0)
  lastError        String?
  sentAt           DateTime?
  /// Phase 9 delivery lease. Two dispatcher runs cannot both send the same
  /// alert: one wins the atomic claim, the other skips it. A crash leaves a
  /// stale lease that is reclaimable after the configured timeout, so a
  /// half-delivered alert is never lost — only, at worst, sent twice.
  claimedAt        DateTime?
  claimOwner       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tradeExecutionId])
  @@index([status])
}

// ===========================================================================
// Phase 9 — durable execution notification outbox (Telegram)
// ===========================================================================

/// Informational execution milestones. CRITICAL_PROTECTION_FAILURE is
/// deliberately absent: Phase 7 CriticalAlert stays the single authoritative
/// durable record for critical conditions and is delivered through the same
/// dispatcher, so no second competing critical model exists.
enum ExecutionNotificationType {
  LIMIT_PLACED
  PARTIAL_FILL
  POSITION_FILLED
  POSITION_PROTECTED
  ENTRY_EXPIRED
  CLOSED_TP
  CLOSED_SL
  CLOSED_EMERGENCY
  /// Closure proven but unattributed — see TradeExecutionStatus.CLOSED_EXTERNAL.
  CLOSED_EXTERNAL
  TRADE_SKIPPED
}

enum ExecutionNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ExecutionNotificationStatus {
  PENDING
  DELIVERED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

/// Append-only proof that protection coverage was VERIFIED complete at a
/// point in time.
///
/// Phase 7 tracks protection on ExecutionProtectionState, which is mutable and
/// only ever shows the LATEST coverage — so a notification runner that was
/// offline across "protected 0.10" then "protected 0.25" could never learn that
/// 0.10 happened. This row is the durable history that makes the earlier
/// milestone recoverable.
///
/// Deliberately NOT an ExecutionEvent: that table's sequenceNumber is
/// TradeExecution.version, so inserting into its sequence space would collide
/// with the next lifecycle write and roll back a TRADING transaction. Protection
/// verification therefore carries the protection row's own version instead,
/// which already increments per state change and cannot collide.
///
/// Written only when the lifecycle actually proved full STOP + TP coverage of
/// the confirmed exposure. Never updated, never deleted.
model ExecutionProtectionVerification {
  id               String         @id @default(cuid())
  tradeExecutionId String
  tradeExecution   TradeExecution @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)
  /// ExecutionProtectionState.version at the moment of verification.
  protectionVersion Int
  state             ProtectionState
  /// Exact decimal quantities frozen at verification time.
  confirmedOpenQuantity       Decimal @db.Decimal(40, 18)
  protectedStopQuantity       Decimal @db.Decimal(40, 18)
  protectedTakeProfitQuantity Decimal @db.Decimal(40, 18)
  /// Null is never "safe" — a milestone requires an explicit true.
  liquidationSafe   Boolean?
  generation        Int
  verifiedAt        DateTime
  createdAt         DateTime @default(now())
  notificationCheckpoint ExecutionNotificationCheckpoint?

  @@unique([tradeExecutionId, protectionVersion])
  @@index([tradeExecutionId])
}

/// Per-record materialization ledger.
///
/// The runner discovers work by asking each durable history table for rows with
/// NO checkpoint — an index-backed anti-join over a real relation, so a bounded
/// batch stays bounded no matter how large the history grows. Deliberately not
/// a timestamp watermark: two events can share a createdAt to the millisecond
/// and a watermark would silently skip one of them.
///
/// The checkpoint and the notification rows it produced commit in ONE
/// transaction: a crash before commit leaves the source rediscoverable, and a
/// crash after commit leaves both present. The unique dedupe key on
/// ExecutionNotification remains the final backstop.
///
/// Exactly one of the two source columns is set. Both are UNIQUE, which is what
/// makes "at most one checkpoint per source" a database guarantee rather than a
/// convention, and Cascade so this derived bookkeeping can never restrict the
/// deletion of the lifecycle history it points at.
model ExecutionNotificationCheckpoint {
  id                       String                           @id @default(cuid())
  executionEventId         String?                          @unique
  executionEvent           ExecutionEvent?                  @relation(fields: [executionEventId], references: [id], onDelete: Cascade)
  protectionVerificationId String?                          @unique
  protectionVerification   ExecutionProtectionVerification? @relation(fields: [protectionVerificationId], references: [id], onDelete: Cascade)
  processedAt              DateTime
  createdAt                DateTime                         @default(now())
}

/// Durable outbox for execution Telegram notifications.
///
/// The row is written from DURABLY CONFIRMED persisted state only, outside any
/// lifecycle transaction, and delivery happens separately. Telegram can be down
/// for a week without touching a single trading decision.
///
/// Content is sanitized: no bot token, no chat id, no API key or secret, no raw
/// Telegram or Binance payload, no account balance, no account identifier.
model ExecutionNotification {
  id               String         @id @default(cuid())
  tradeExecutionId String
  // Restrict: financial/audit history is never removed implicitly.
  tradeExecution   TradeExecution @relation(fields: [tradeExecutionId], references: [id], onDelete: Restrict)

  notificationType ExecutionNotificationType
  /// Deterministic per (execution, type, milestone discriminator). UNIQUE, so
  /// concurrent materializers cannot create two rows for the same milestone —
  /// the guarantee is the database constraint, never an in-memory check.
  dedupeKey        String                        @unique
  severity         ExecutionNotificationSeverity @default(INFO)
  /// Causal delivery order within one materialization batch. Guarantees a
  /// restart never sends CLOSED_TP before POSITION_FILLED.
  milestoneSequence Int
  /// Sanitized exact-decimal-string snapshot frozen at materialization; the
  /// message is rendered from this, so late state changes cannot rewrite an
  /// already-earned milestone.
  payloadSnapshot  Json

  deliveryStatus   ExecutionNotificationStatus @default(PENDING)
  attemptCount     Int                         @default(0)
  lastAttemptAt    DateTime?
  deliveredAt      DateTime?
  lastErrorCode    String?
  sanitizedLastError String?
  /// Delivery lease — see CriticalAlert.claimedAt.
  claimedAt        DateTime?
  claimOwner       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeExecutionId])
  @@index([deliveryStatus, createdAt])
}

// ===========================================================================
// Phase 11B.0 — one-shot live-canary authorization
// ===========================================================================

enum CanaryDirection {
  LONG
  SHORT
}

/// Which KIND of authorization a row is.
///
/// The discriminator is AUTHORITATIVE. Nothing infers the mode from which
/// columns happen to be null: a row means what this column says it means, and
/// a null field is then a structural defect in that row rather than a hint
/// about another mode. That is what lets the exact-signal flow keep its
/// existing behaviour byte for byte while the natural window is still only a
/// shape in the schema.
enum CanaryAuthorizationType {
  /// Phase 11B.0, unchanged: one operator token, one symbol, one direction,
  /// one use, short-lived. Every row written before this column existed is
  /// this, by DEFAULT — see the migration.
  EXACT_SIGNAL

  /// Phase 12 — SCHEMA ONLY so far. A server-side window carrying no token,
  /// admitting any signal whose direction is in `allowedDirections`, bounded by
  /// a cumulative `maxClaims`. No production code creates, reads or admits one
  /// yet.
  ///
  /// It names no symbols. Which symbols can fire at all is decided by the
  /// operator's TradingView watchlist, and whether one can be traded is decided
  /// by the checks that already exist — Binance listing, contract type, margin
  /// and filter eligibility, a valid deterministic plan, then safety admission.
  /// The backend keeps no second copy of that watchlist.
  NATURAL_WINDOW
}

/// Durable proof that ONE specific signal is the intended live canary.
///
/// Capacity limits protect the account from over-trading; they do not identify
/// WHICH trade was meant. `allowedSymbols` narrows the symbol but still admits
/// either direction and any number of signals on it. This row is the missing
/// identity: one profile, one symbol, one direction, one use, short-lived.
///
/// It is an ADDITIONAL guard. It never bypasses the global kill switch, the
/// profile kill switch, `isEnabled`, SafetyAdmission, capacity, the risk
/// ceiling or the live-entry/protection gates — a match means "this is the
/// intended canary", never "skip the normal checks".
///
/// Restrict on the profile: this is operator-authorization history and must not
/// vanish implicitly.
///
/// ## Two modes, one table (Phase 12 — schema only)
///
/// `authorizationType` splits this row into two shapes that share expiry,
/// revocation, profile scope and history. Prisma cannot express cross-field
/// constraints, so these invariants are the DOMAIN's to enforce — they are
/// written here because the schema is where a reader looks for them:
///
///   EXACT_SIGNAL (every row that exists today)
///     allowedSymbol      REQUIRED
///     allowedDirection   REQUIRED
///     tokenHash          REQUIRED
///     allowedDirections  unused (empty)
///     maxClaims          unused (null) — the budget is one, held by consumedAt
///
///   NATURAL_WINDOW (nothing creates one yet)
///     allowedSymbol      null   — a window names no symbol at all
///     allowedDirection   null
///     tokenHash          null   — authorized server-side, no secret exists
///     allowedDirections  NON-EMPTY
///     maxClaims          >= 1
///     claimedCount       >= 0 and <= maxClaims
///     expiresAt          REQUIRED (as for every mode)
///
/// A window carries no symbol list, and no field here is a symbol list. Which
/// symbols may fire is the operator's TradingView watchlist; which of those can
/// actually be traded is settled by the eligibility the execution stack already
/// enforces. `ExecutionSafetyPolicy.allowedSymbols` keeps its own independent
/// meaning and is not this model's business.
///
/// A row failing its own mode's invariants is a defect, never a hint that it
/// meant the other mode. Exact-mode readers assert the three required fields
/// and refuse the row otherwise — see `isExactAuthorization`.
/// Whether a session may still admit new trades.
///
/// EXHAUSTED and EXPIRED are deliberately distinct: one means the budget is
/// spent while time remains, the other means time ran out while budget
/// remained. Collapsing them would tell the operator the wrong thing about
/// what to change.
enum TradingSessionStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

/// Where one session slot is in its life.
///
/// RESERVED is held from admission until the entry proves what it did.
/// OPENED is terminal and never returns to the pool — a closed position does
/// not give its trade back. RELEASED is terminal too, and only reachable when
/// the entry died having never touched the exchange.
enum SessionSlotState {
  RESERVED
  OPENED
  RELEASED
}

/// A bounded window of automated trading, measured in trades that actually
/// obtained exposure.
///
/// ## Why this is not `maxClaims`
///
/// `ExecutionCanaryAuthorization.claimedCount` is spent at ADMISSION and is
/// never refunded, so five claims buy five admissions rather than five
/// positions — an entry that never fills consumes budget permanently. That is
/// the exact behaviour the 2026-08-26 session showed, where one claim died on
/// an entry that never filled and the window still read 5/5.
///
/// A session counts differently: a slot is RESERVED at admission and only
/// becomes OPENED when the execution first obtains non-zero exposure. An entry
/// that expires, is cancelled or fails without ever filling RELEASES its slot
/// back to the budget.
///
/// ## What it is not
///
/// It is not a concurrency limit and not a loss limit. `ExecutionSafetyPolicy`
/// remains authoritative for simultaneous exposure, risk and margin; a session
/// budget of 100 with maxTotalActiveTrades 5 means at most 100 trades in
/// sequence, never more than 5 at once. Every existing gate still runs.
model TradingSession {
  id                 String           @id @default(cuid())
  executionProfileId String
  executionProfile   ExecutionProfile @relation(fields: [executionProfileId], references: [id], onDelete: Restrict)

  status TradingSessionStatus @default(ACTIVE)

  /// The finite number of trades that may obtain exposure. Null ONLY when
  /// `unlimited` is true, which the server permits solely for an objectively
  /// non-live environment — there is no unlimited real-money session.
  tradeBudget Int?

  /// Deliberately explicit rather than inferred from a null budget: an
  /// unlimited session is a decision someone made, not a missing value.
  unlimited Boolean @default(false)

  /// Executions that have obtained exposure at least once. Monotonic — a
  /// position closing does not decrement it.
  openedCount Int @default(0)

  /// Slots held by entries that can still fill. Rises at admission and falls
  /// on release or on conversion to opened.
  reservedCount Int @default(0)

  startedAt DateTime @default(now())
  expiresAt DateTime
  endedAt   DateTime?

  /// Optimistic-lock counter, matching ExecutionSafetyPolicy.version.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots          TradingSessionSlot[]
  authorizations ExecutionCanaryAuthorization[]

  @@index([executionProfileId, status])
  @@index([expiresAt])
}

/// One execution's claim on one session slot.
///
/// The unique constraint on `tradeExecutionId` is the idempotency mechanism,
/// and it is enforced by the database rather than by any caller: an execution
/// cannot reserve twice, and first-fill accounting can run from every recovery
/// path without ever counting the same execution again.
model TradingSessionSlot {
  id               String           @id @default(cuid())
  tradingSessionId String
  tradingSession   TradingSession   @relation(fields: [tradingSessionId], references: [id], onDelete: Restrict)

  /// One slot per execution, forever. This is what makes both the conversion
  /// to OPENED and the RELEASE safe to attempt repeatedly.
  tradeExecutionId String @unique

  state SessionSlotState @default(RESERVED)

  reservedAt DateTime  @default(now())
  /// Set once, from the execution's own firstFillAt. Never moved.
  openedAt   DateTime?
  releasedAt DateTime?
  /// Why the slot went back to the pool. Never a credential or a raw error.
  releaseReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradingSessionId, state])
}

model ExecutionCanaryAuthorization {
  id                 String           @id @default(cuid())
  executionProfileId String
  executionProfile   ExecutionProfile @relation(fields: [executionProfileId], references: [id], onDelete: Restrict)

  /// The authoritative mode. DEFAULT EXACT_SIGNAL is what makes this column
  /// additive: every historical row keeps exactly the meaning it already had,
  /// and no row can become a NATURAL_WINDOW by accident or by inference.
  authorizationType CanaryAuthorizationType @default(EXACT_SIGNAL)

  /// EXACT_SIGNAL only — the one normalized uppercase symbol it admits.
  ///
  /// Nullable because a NATURAL_WINDOW names no symbol: it authorizes a
  /// direction and a claim budget, never a ticker. Null is the honest
  /// representation of "this row does not restrict the symbol"; a placeholder
  /// or a `"*"` sentinel would be a wildcard wearing a symbol's clothes.
  allowedSymbol   String?

  /// EXACT_SIGNAL only. A NATURAL_WINDOW uses `allowedDirections` instead, so
  /// this stays null rather than defaulting to a direction nobody chose.
  allowedDirection CanaryDirection?

  /// SHA-256 of the one-time operator token. The raw token is shown once at
  /// prepare time and never persisted, logged or returned anywhere.
  ///
  /// EXACT_SIGNAL only. A NATURAL_WINDOW is authorized entirely server-side
  /// and has no secret, so this is null — fabricating a hash would put a
  /// credential-shaped value in the audit trail that unlocks nothing.
  /// Still UNIQUE: PostgreSQL admits many NULLs under a unique index, so the
  /// one-token-one-row guarantee is untouched.
  tokenHash String? @unique

  /// NATURAL_WINDOW only — the directions the window admits.
  ///
  /// Empty admits NOTHING. That is the point of the default: a window that has
  /// not had directions chosen for it cannot widen anything.
  allowedDirections CanaryDirection[] @default([])

  /// The session this window authorizes for, when it has one.
  ///
  /// This is what makes a window SESSION-BACKED, and it is a durable link
  /// rather than an inference: "is there an active session for this profile?"
  /// would be ambiguous the moment a legacy window and a new session coexist.
  ///
  /// Null means LEGACY — a window prepared before sessions existed, or by a
  /// path that does not open one. A legacy window keeps the historical
  /// `maxClaims` behaviour exactly; a session-backed one is bounded by its
  /// session's trade budget instead, and spends no claim at all.
  tradingSessionId String?
  tradingSession   TradingSession? @relation(fields: [tradingSessionId], references: [id], onDelete: Restrict)

  /// NATURAL_WINDOW only — the CUMULATIVE number of admitted executions this
  /// window may ever produce, across its whole lifetime.
  ///
  /// Null for EXACT_SIGNAL, whose budget is structurally one (`consumedAt`).
  /// There is deliberately NO representation for "unlimited": a window with no
  /// number is a window with no ceiling, and every other limit in this system
  /// fails closed.
  maxClaims Int?

  /// How many claims have been spent. NEVER decremented — a claim is not
  /// refunded when its execution later expires unfilled, so this stays a
  /// durable audit fact instead of a mutable counter that could be raced.
  claimedCount Int @default(0)

  /// Optimistic-lock counter, matching `ExecutionSafetyPolicy.version`. The
  /// future claim is a conditional update guarded on it; nothing increments it
  /// yet.
  version Int @default(1)

  /// Required for BOTH modes. There is no "never expires" authorization and no
  /// infinite sentinel: an unused window should shut on its own.
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Set the instant the authorization is bound to a signal. Binding is what
  /// makes it one-shot; it is deliberately distinct from the execution having
  /// SUCCEEDED, so a crash after binding leaves the SAME execution recoverable
  /// while never letting a different one reuse the authorization.
  consumedAt        DateTime?
  consumedAlertId   String?
  consumedExecutionId String?

  revokedAt DateTime?

  @@index([executionProfileId])
  @@index([expiresAt])
  @@index([tradingSessionId])
}

/// The decision the selected-plan executor reached for one alert's plan.
///
/// Exists because that decision was previously LOG-ONLY. Every refusal in
/// `SelectedPlanExecutor.handleSelectedPlan` returns before any TradeExecution
/// is created, so neither ExecutionEvent nor SafetyAdmission can hold it —
/// both require a tradeExecutionId. Without this row an alert with a READY
/// plan and no execution could only ever be described as "reason unavailable".
///
/// Observability only. Nothing reads this to decide anything: it is written
/// AFTER the decision has already been returned, and no trading path consults
/// it. Deleting every row here would change no trading behaviour whatsoever.
///
/// One row per alert. `ExtremeRRPlan.alertId` is itself unique and a READY plan
/// is frozen (`generateForAlert` returns an existing READY plan untouched), so
/// repeated evaluation re-decides the SAME immutable plan and must not append
/// duplicate history. A non-READY plan may legitimately regenerate and be
/// evaluated again; the newer decision then replaces a verdict whose subject no
/// longer exists.
model SelectedPlanOutcome {
  id      String @id @default(cuid())
  alertId String @unique
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  /// The plan that was evaluated. Kept so the row can never be read as a
  /// verdict on some later plan for the same alert.
  /// Unique for the same reason `alertId` is: plan and alert are already 1:1
  /// (`ExtremeRRPlan.alertId` is unique, and its row id is stable across
  /// regeneration because generation upserts by alertId). Constraining both
  /// makes "one verdict per plan" an invariant the database enforces rather
  /// than something every writer has to remember.
  extremeRRPlanId String        @unique
  extremeRRPlan   ExtremeRRPlan @relation(fields: [extremeRRPlanId], references: [id], onDelete: Cascade)

  /// False for a pre-execution refusal; true when an execution was reached.
  handled Boolean

  /// The canonical code the executor returned, stored verbatim. A
  /// SelectedPlanSkipReason when handled=false, otherwise the admission
  /// reason code. Never re-interpreted here.
  reasonCode String?

  /// The executor's own sentence. Never a formatted UI string, never an error
  /// object, and never anything derived from the environment.
  message String?

  /// Set only when handled=true. Intentionally NOT a foreign key: this row is
  /// a historical record, and it must survive independently of the execution
  /// it mentions.
  executionId String?

  /// When the decision was actually made. The whole point of the model: the
  /// dashboard reports what was true THEN, never what is true now.
  evaluatedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reasonCode])
  @@index([evaluatedAt])
}
