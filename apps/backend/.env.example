# PostgreSQL connection used by Prisma (backend + worker)
# Port 55432 matches docker-compose.yml's host mapping (chosen to avoid clashing
# with a locally installed Postgres on the default 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/trading_alert_dashboard?schema=public

# Redis connection used by BullMQ (queue + worker)
REDIS_URL=redis://localhost:6379

# Backend HTTP server
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# Shared secret TradingView must send in the webhook payload
WEBHOOK_SECRET=change-me

# Where generated chart screenshots are written, relative to apps/backend
SCREENSHOT_STORAGE_DIR=src/storage/screenshots

# AI Vision provider: "mock" (default, no API calls) or "openai" (real vision).
AI_VISION_PROVIDER=mock

# OpenAI vision credentials/config. OPENAI_API_KEY is REQUIRED when
# AI_VISION_PROVIDER=openai (startup fails clearly otherwise).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Max time to wait for the AI vision response before aborting.
AI_VISION_TIMEOUT_MS=30000

# If the real AI provider fails: "true" logs a warning and returns a mock
# result; "false" (default) fails the worker job (alert -> FAILED).
AI_VISION_FALLBACK_TO_MOCK=false

# Reject screenshots larger than this many bytes before sending to the AI
# provider (cost/safety guard). Default 5 MB.
AI_VISION_MAX_IMAGE_BYTES=5000000

# Alerts matching symbol+assetType+timeframe+signal+indicatorName within this
# many seconds of an existing alert are suppressed as duplicates instead of
# creating a new alert / screenshot / AI analysis job.
DUPLICATE_SUPPRESSION_WINDOW_SECONDS=60

# Binance public REST API base URL (no API key needed for klines/candles)
BINANCE_REST_BASE_URL=https://api.binance.com

# Market data provider for CRYPTO alerts on the BINANCE exchange. Currently
# only "binance" (real klines) is implemented; anything else falls back to
# mock candles, same as STOCK alerts always do.
MARKET_DATA_PROVIDER=binance

# If the real Binance fetch fails: "true" logs a warning and falls back to
# mock candles; "false" (default) fails the worker job (alert -> FAILED).
MARKET_DATA_FALLBACK_TO_MOCK=false

# Optional Telegram notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
