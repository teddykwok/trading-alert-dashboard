{
  "name": "@trading-alert-dashboard/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify + Prisma + BullMQ backend for the trading alert dashboard.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "tsx watch src/modules/jobs/vision-analysis.worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "retention:dry-run": "tsx src/modules/retention/run-retention.ts",
    "retention:apply": "tsx src/modules/retention/run-retention.ts --apply",
    "binance:read-only-check": "tsx src/modules/binance/run-read-only-check.ts",
    "binance:margin-plan": "tsx src/modules/binance/run-margin-plan.ts",
    "binance:liquidation-check": "tsx src/modules/binance/run-liquidation-validation.ts",
    "binance:account-health": "tsx src/modules/binance/run-account-health.ts",
    "binance:set-hedge-mode": "tsx src/modules/binance/run-set-hedge-mode.ts",
    "binance:test-order": "tsx src/modules/binance/run-test-order.ts",
    "execution:canary-preflight": "tsx src/modules/execution/run-canary-preflight.ts",
    "execution:ensure-profile": "tsx src/modules/execution/run-ensure-profile.ts",
    "test": "vitest run",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.13.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@trading-alert-dashboard/shared": "workspace:*",
    "bullmq": "^5.7.8",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "lightweight-charts": "^4.1.7",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "playwright": "^1.44.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.11",
    "prisma": "^5.13.0",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
