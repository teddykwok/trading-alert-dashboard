VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# Extra hostnames the Vite DEV server may respond to, comma-separated. Used for
# private remote access via Tailscale Serve (which proxies to localhost:5173).
# localhost and IP addresses are always allowed without listing them here.
# Set the real value in a gitignored apps/frontend/.env.local, e.g.:
#   VITE_DEV_ALLOWED_HOSTS=laptop-iba30vh5.tail2aad2e.ts.net
VITE_DEV_ALLOWED_HOSTS=
