# Optional overrides for where the browser reaches the backend. Leave EMPTY to
# use same-origin requests through the Vite dev proxy (/api and /socket.io ->
# 127.0.0.1:4000). Empty is what makes private remote access via Tailscale
# Serve work — the browser only ever talks to its own origin. Set an absolute
# URL only if you intentionally point the frontend at a separate API host.
VITE_API_URL=
VITE_SOCKET_URL=

# Extra hostnames the Vite DEV server may respond to, comma-separated. Used for
# private remote access via Tailscale Serve (which proxies to localhost:5173).
# localhost and IP addresses are always allowed without listing them here.
# Set the real value in a gitignored apps/frontend/.env.local, e.g.:
#   VITE_DEV_ALLOWED_HOSTS=laptop-iba30vh5.tail2aad2e.ts.net
VITE_DEV_ALLOWED_HOSTS=
