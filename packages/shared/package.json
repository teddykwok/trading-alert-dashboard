{
  "name": "@trading-alert-dashboard/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and constants used by both the backend and frontend.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  }
}
